            "value": "מעדכן מדדים פעילים כל 5 שניות ללא קשר למצב החלונית."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตตัวชี้วัดที่ใช้งานอยู่ทุก 5 วินาที โดยไม่คำนึงถึงสถานะของแผงควบคุม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật các chỉ số đang hoạt động mỗi 5 giây bất kể trạng thái của bảng điều khiển."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
