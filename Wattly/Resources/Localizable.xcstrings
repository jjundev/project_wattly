    "4개의 수직 디지털 바가 연산 및 전력 부하에 맞춰 상하 바운스합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتد أربعة أشرطة رقمية رأسية لأعلى ولأسفل وفقًا للحوسبة وحمل الطاقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři svislé digitální pruhy kmitají nahoru a dolů podle výpočetního a energetického zatížení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire lodrette digitale bjælker hopper op og ned i takt med beregnings- og strømbelastning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier vertikale digitale Balken bewegen sich passend zur Rechen- und Stromlast auf und ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέσσερις κάθετες ψηφιακές μπάρες αναπηδούν πάνω-κάτω σύμφωνα με το υπολογιστικό φορτίο και το φορτίο ισχύος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four vertical digital bars bounce up and down with computational and power load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro barras digitales verticales rebotan arriba y abajo según la carga informática y de energía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neljä pystysuoraa digitaalipalkkia pomppii ylös ja alas laskenta- ja virtakuorman mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre barres numériques verticales oscillent de haut en bas selon la charge de calcul et d'alimentation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארבעה פסים דיגיטליים אנכיים קופצים מעלה ומטה בהתאם לעומס החישוב והחשמל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार ऊर्ध्वाधर डिजिटल बार कम्प्यूटेशनल और बिजली भार के साथ ऊपर-नीचे उछलते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Négy függőleges digitális sáv mozog fel-le a számítási és energiaigénynek megfelelően."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat bilah digital vertikal memantul naik turun sesuai dengan beban komputasi dan daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro barre digitali verticali oscillano su e giù in base al carico computazionale e di potenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4本の垂直デジタルバーが演算および電力負荷に合わせて上下にバウンドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4개의 수직 디지털 바가 연산 및 전력 부하에 맞춰 상하 바운스합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire vertikale digitale stolper spretter opp og ned i takt med beregnings- og strømbelastning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier verticale digitale staven bewegen op en neer op basis van reken- en stroombelasting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cztery pionowe słupki cyfrowe odbijają się w górę i w dół w zależności od obciążenia obliczeniowego i mocy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro barras digitais verticais oscilam para cima e para baixo com a carga computacional e de energia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro barras digitais verticais oscilam para cima e para baixo com a carga computacional e de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Patru bare digitale verticale oscilează în sus și în jos în funcție de sarcinile de calcul și de putere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре вертикальные цифровые полосы колеблются вверх и вниз в такт вычислительной нагрузке и мощности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyra vertikala digitala staplar studsar upp och ner i takt med beräknings- och strömbelastning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบดิจิทัลแนวตั้ง 4 แถบกระเด้งขึ้นลงตามภาระการประมวลผลและการใช้พลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört dikey dijital çubuk, hesaplama ve güç yüküne göre yukarı ve aşağı hareket eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чотири вертикальні цифрові стовпчики коливаються вгору і вниз відповідно до обчислювального та енергетичного навантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn thanh kỹ thuật số thẳng đứng nảy lên xuống theo tải tính toán và năng lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四个垂直数字条随计算和功率负载上下跳动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四條垂直數位長條隨運算及功率負載上下跳動。"
          }
        }
      }
    },
