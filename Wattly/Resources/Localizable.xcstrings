          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает выбранные показатели рядом со значком в строке меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображає вибрані показники поруч зі значком на смузі меню."
          }
        },
        "tr": {
          "stringUnit": {
