    "1. 아래 버튼으로 시스템 설정 > 배터리 이동": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1. استخدم الزر أدناه لفتح إعدادات النظام > البطارية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Pomocí tlačítka níže otevřete Nastavení systému > Baterie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Brug knappen nedenfor til at åbne Systemindstillinger > Batteri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Verwenden Sie die Schaltfläche unten, um Systemeinstellungen > Batterie zu öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Χρησιμοποιήστε το παρακάτω κουμπί για να ανοίξετε τις Ρυθμίσεις συστήματος > Μπαταρία"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Use the button below to open System Settings > Battery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Usa el botón de abajo para abrir Ajustes del Sistema > Batería"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Avaa Järjestelmäasetukset > Akku alla olevalla painikkeella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Utilisez le bouton ci-dessous pour ouvrir Réglages Système > Batterie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "1. השתמש בכפתור למטה כדי לפתוח את הגדרות המערכת > סוללה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. सिस्टम सेटिंग्स > बैटरी खोलने के लिए नीचे दिए गए बटन का उपयोग करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Használja az alábbi gombot a Rendszerbeállítások > Akkumulátor megnyitásához"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Gunakan tombol di bawah untuk membuka Pengaturan Sistem > Baterai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Usa il pulsante in basso per aprire Impostazioni di Sistema > Batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 下のボタンで「システム設定 > バッテリー」を開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 아래 버튼으로 시스템 설정 > 배터리 이동"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Bruk knappen nedenfor for å åpne Systeminnstillinger > Batteri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Gebruik de onderstaande knop om Systeeminstellingen > Batterij te openen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Użyj przycisku poniżej, aby otworzyć Ustawienia systemowe > Bateria"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Use o botão abaixo para abrir Ajustes do Sistema > Bateria"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Utilize o botão abaixo para abrir Definições do Sistema > Bateria"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Utilizați butonul de mai jos pentru a deschide Configurări sistem > Baterie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Нажмите кнопку ниже, чтобы открыть «Системные настройки» > «Аккумулятор»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Använd knappen nedan för att öppna Systeminställningar > Batteri"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ใช้ปุ่มด้านล่างเพื่อเปิด การตั้งค่าระบบ > แบตเตอรี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sistem Ayarları > Pil bölümünü açmak için aşağıdaki düğmeyi kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Скористайтеся кнопкою нижче, щоб відкрити Системні параметри > Акумулятор"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sử dụng nút bên dưới để mở Cài đặt hệ thống > Pin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 使用下方按钮打开“系统设置 > 电池”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 使用下方按鈕開啟「系統設定 > 電池」"
          }
        }
      }
    },
