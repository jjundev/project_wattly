    "앱 번들에서 도우미 실행 파일을 찾을 수 없습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 번들에서 도우미 실행 파일을 찾을 수 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find the helper executable in the app bundle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリバンドル内にヘルパー実行ファイルが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用程序包中找不到助手可执行文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在應用程式套件中找不到輔助程式可執行檔。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausführbare Helferdatei wurde im App-Bundle nicht gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver l'exécutable de l'assistant dans le bundle de l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
