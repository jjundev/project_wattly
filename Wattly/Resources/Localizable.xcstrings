          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj devam ettirilemedi (güç adaptörünü yeniden takmayı deneyin)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر استئناف الشحن (جرّب إعادة توصيل محول الطاقة)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לחדש את הטעינה (נסה לחבר מחדש את מתאם המתח)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถชาร์จต่อได้ (ลองเชื่อมต่ออะแดปเตอร์ไฟฟ้าใหม่)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tiếp tục sạc (hãy thử kết nối lại bộ chuyển đổi nguồn)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat melanjutkan pengisian daya (coba sambungkan kembali adaptor daya)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्जिंग फिर से शुरू नहीं हो सकी (पावर एडाप्टर को फिर से कनेक्ट करने का प्रयास करें)"
          }
        }
      }
    },
    "충전이 시작되지 않습니다. 시스템 설정 › 배터리에서 \"최적화된 배터리 충전\"을 꺼 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charging will not start. Turn off Optimized Battery Charging in System Settings › Battery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ladevorgang startet nicht. Deaktiviere „Optimiertes Laden der Batterie“ in Systemeinstellungen › Batterie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電が開始されません。システム設定 > バッテリーで「バッテリー充電の最適化」をオフにしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge ne démarre pas. Désactivez « Recharge optimisée de la batterie » dans Réglages Système › Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga no se inicia. Desactiva 'Recarga optimizada' en Ajustes del Sistema › Batería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricarica non si avvia. Disattiva 'Caricamento ottimizzato' in Impostazioni di Sistema › Batteria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento não inicia. Desative o 'Carregamento Otimizado' em Ajustes do Sistema › Bateria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O carregamento não inicia. Desative o 'Carregamento otimizado' em Definições do Sistema › Bateria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opladen start niet. Schakel 'Geoptimaliseerd opladen' uit in Systeeminstellingen › Batterij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddningen startar inte. Stäng av 'Optimerad batteriladdning' i Systeminställningar › Batteri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opladning starter ikke. Slå 'Optimeret batteriopladning' fra i Systemindstillinger › Batteri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus ei käynnisty. Poista 'Optimoitu akun lataus' käytöstä kohdassa Järjestelmäasetukset › Akku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladingen starter ikke. Slå av «Optimert batterilading» i Systeminnstillinger › Batteri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładowanie się nie rozpoczyna. Wyłącz „Zoptymalizowane ładowanie” w Ustawieniach systemowych › Bateria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabíjení se nespustí. Vypněte „Optimalizované nabíjení baterie“ v Nastavení systému › Baterie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A töltés nem indul el. Kapcsold ki az „Optimalizált akkutöltés” funkciót a Rendszerbeállítások › Akkumulátor menüben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcarea nu pornește. Dezactivează „Încărcare optimizată a bateriei” din Setări sistem › Baterie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φόρτιση δεν ξεκινά. Απενεργοποιήστε τη «Βελτιστοποιημένη φόρτιση μπαταρίας» στις Ρυθμίσεις Συστήματος › Μπαταρία."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядка не начинается. Отключите «Оптимизированную зарядку» в Системных настройках › Батарея."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряджання не розпочинається. Вимкніть «Оптимізоване заряджання» в Системних налаштуваннях › Акумулятор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
