        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon stays paused while reading selected workload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した負荷の読み込み中、アイコンは停止します。"
