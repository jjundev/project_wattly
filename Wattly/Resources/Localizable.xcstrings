    "Wattly 시그니처 W 파형이 좌에서 우로 전파되며 전력 부하에 따라 가속됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتشر موجة W المميزة لـ Wattly من اليسار إلى اليمين وتتسارع وفقًا لحمل الطاقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Charakteristická křivka W aplikace Wattly se šíří zleva doprava a zrychluje se podle zatížení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattlys signatur W-bølgeform udbreder sig fra venstre mod højre og accelererer efter strømbelastning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die charakteristische Wattly W-Wellenform breitet sich von links nach rechts aus und beschleunigt sich je nach Leistungslast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χαρακτηριστική κυματομορφή W του Wattly διαδίδεται από αριστερά προς τα δεξιά και επιταχύνεται ανάλογα με το φορτίο ισχύος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Wattly signature W waveform propagates from left to right and accelerates based on power load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma de onda W distintiva de Wattly se propaga de izquierda a derecha y se acelera según la carga de energía."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattlyn tunnusomainen W-aaltomuoto etenee vasemmalta oikealle ja kiihtyy tehokuorman mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme d'onde W emblématique de Wattly se propage de gauche à droite et s'accélère selon la charge énergétique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צורת הגל W הייחודית של Wattly מתפשטת משמאל לימין ומאיצה בהתאם לעומס החשמל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly का सिग्नेचर W वेवफ़ॉर्म बाएं से दाएं फैलता है और पावर लोड के अनुसार तेज होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Wattly jellegzetes W hullámformája balról jobbra terjed, és az energiaterhelés függvényében gyorsul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk gelombang W khas Wattly merambat dari kiri ke kanan dan berakselerasi berdasarkan beban daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma d'onda W caratteristica di Wattly si propaga da sinistra a destra e accelera in base al carico di potenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WattlyシグネチャーのW波形が左から右へと伝播し、電力負荷に応じて加速します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly 시그니처 W 파형이 좌에서 우로 전파되며 전력 부하에 따라 가속됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattlys signatur W-bølgeform forplanter seg fra venstre til høyre og akselererer basert på strømbelastning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kenmerkende W-golfvorm van Wattly plant zich voort van links naar rechts en versnelt op basis van stroombelasting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Charakterystyczny dla Wattly przebieg falowy W rozchodzi się od lewej do prawej i przyspiesza wraz z obciążeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma de onda W exclusiva do Wattly propaga-se da esquerda para a direita e acelera conforme a carga de energia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma de onda W exclusiva do Wattly propaga-se da esquerda para a direita e acelera de acordo com a carga de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma de undă W caracteristică Wattly se propagă de la stânga la dreapta și accelerează în funcție de sarcina de putere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фирменная W-волна Wattly распространяется слева направо и ускоряется в зависимости от энергопотребления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattlys signaturvågform W propagerar från vänster till höger och accelererar baserat på effektbelastning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลื่นรูปตัว W อันเป็นเอกลักษณ์ของ Wattly จะเคลื่อนที่จากซ้ายไปขวาและเร่งความเร็วตามโหลดพลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly imza W dalga formu soldan sağa yayılır ve güç yüküne bağlı olarak hızlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фірмова хвиля W від Wattly поширюється зліва направо та прискорюється залежно від енергоспоживання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dạng sóng W đặc trưng của Wattly lan truyền từ trái sang phải và tăng tốc dựa trên tải điện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly 标志性的 W 波形从左向右传播，并根据功率负载加速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly 標誌性的 W 波形從左向右傳播，並根據功率負載加速。"
          }
        }
      }
    },
