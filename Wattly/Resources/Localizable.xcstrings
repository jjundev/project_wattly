            "state": "translated",
            "value": "Voulez-vous désinstaller Wattly et supprimer toutes les données ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם להסיר את התקנת Wattly ולמחוק את כל הנתונים?"
