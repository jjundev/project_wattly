    "3차원 대각선 축을 기준으로 와이어프레임 큐브가 자전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدور مكعب الإطار السلكي حول محور قطري ثلاثي الأبعاد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drátěná krychle rotuje podél 3D diagonální osy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En trådrammekubus roterer langs en 3D-diagonalakse."
          }
        },
        "de": {
          "stringUnit": {
