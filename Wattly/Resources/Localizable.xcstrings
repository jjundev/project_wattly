    "한 번만 완충 또는 수동 방전이 진행 중입니다. 먼저 끝내 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top Up or Manual Discharge is running. Finish it first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalig voll aufladen oder Manuelles Entladen läuft bereits. Beende es zuerst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回のみフル充電または手動放電が実行中です。先にそちらを終了してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge complète unique ou Décharge manuelle est en cours. Terminez-la d'abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga completa una vez o Descarga manual está en curso. Termínala primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica completa una tantum o Scarica manuale è in corso. Terminala prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarga Única Completa ou Descarga Manual está em andamento. Termine-a primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarga única completa ou Descarga manual está em curso. Termine-a primeiro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalig volledig opladen of Handmatig ontladen is bezig. Rond dit eerst af."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fulladdning en gång eller Manuell urladdning pågår. Avsluta den först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld opladning én gang eller Manuel afladning kører. Afslut den først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi lataus kerran tai Manuaalinen purku on käynnissä. Lopeta se ensin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullading én gang eller Manuell utlading pågår. Fullfør den først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa Jednorazowe pełne naładowanie lub Ręczne rozładowywanie. Zakończ je najpierw."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá Jednorázové plné dobití nebo Ruční vybíjení. Nejprve to dokončete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Egyszeri teljes töltés vagy a Kézi lemerítés folyamatban van. Fejezd be előbb."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcare completă unică sau Descărcare manuală este în curs. Finalizeaz-o mai întâi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Πλήρης φόρτιση μία φορά ή η Χειροκίνητη εκφόρτιση βρίσκεται σε εξέλιξη. Ολοκληρώστε την πρώτα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется Однократная полная зарядка или Ручная разрядка. Сначала завершите её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконується Одноразове повне заряджання або Ручне розряджання. Спершу завершіть його."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Kerelik Tam Şarj veya Manuel Deşarj sürüyor. Önce onu bitirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشحن الكامل لمرة واحدة أو التفريغ اليدوي قيد التنفيذ. يُرجى إنهاؤها أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טעינה מלאה חד-פעמית או פריקה ידנית פועלת כעת. סיים אותה קודם."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การชาร์จเต็มเพียงครั้งเดียวหรือการคายประจุด้วยตนเองกำลังทำงานอยู่ โปรดทำให้เสร็จก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sạc đầy một lần hoặc Xả thủ công đang chạy. Hãy hoàn tất trước."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi Penuh Sekali atau Pengosongan Manual sedang berjalan. Selesaikan itu dahulu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार पूर्ण चार्ज या मैन्युअल डिस्चार्ज चल रहा है। पहले उसे समाप्त करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性充满或手动放电正在进行中，请先完成它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性充滿或手動放電正在進行中，請先完成它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 완충 또는 수동 방전이 진행 중입니다. 먼저 끝내 주세요."
          }
        }
      }
    },
