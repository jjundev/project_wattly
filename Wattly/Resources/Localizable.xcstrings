    "배터리 셀을 회복시키는 기능이 아니라, 잔량 표시의 추정 오차를 보정하는 장시간 충·방전 절차입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not restore battery cells. It is a long charge/discharge procedure that recalibrates the reported charge level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies stellt keine Akkuzellen wieder her. Es ist ein langer Lade-/Entladevorgang, der die angezeigte Ladung neu kalibriert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーセルを回復させる機能ではなく、残量表示の推定誤差を補正する長時間の充放電手順です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonction ne restaure pas les cellules de la batterie. Il s'agit d'une longue procédure de charge/décharge qui recalibre le niveau de charge affiché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no restaura las celdas de la batería. Es un procedimiento largo de carga/descarga que recalibra el nivel de carga mostrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa funzione non ripristina le celle della batteria. È una lunga procedura di carica/scarica che ricalibra il livello di carica indicato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não restaura as células da bateria. É um procedimento longo de carga/descarga que recalibra o nível de carga exibido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não restaura as células da bateria. É um procedimento longo de carga/descarga que recalibra o nível de carga apresentado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit herstelt geen batterijcellen. Het is een lange laad-/ontlaadprocedure die het weergegeven laadniveau opnieuw kalibreert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta återställer inte battericellerna. Det är en lång ladd-/urladdningsprocedur som omkalibrerar den visade laddningsnivån."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette genopretter ikke batteriets celler. Det er en lang opladnings-/afladningsprocedure, der rekalibrerer det viste opladningsniveau."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei palauta akkukennoja. Kyse on pitkästä lataus-/purkutoimenpiteestä, joka kalibroi näytetyn varaustason uudelleen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gjenoppretter ikke battericellene. Det er en lang lade-/utladingsprosedyre som rekalibrerer det viste ladenivået."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie przywraca ogniw baterii. Jest to długa procedura ładowania/rozładowania, która ponownie kalibruje wyświetlany poziom naładowania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto neobnovuje články baterie. Jde o dlouhý postup nabíjení/vybíjení, který znovu kalibruje zobrazovanou úroveň nabití."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem állítja helyre az akkumulátor celláit. Egy hosszú töltési/merítési folyamat, amely újrakalibrálja a kijelzett töltöttségi szintet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta nu reface celulele bateriei. Este o procedură lungă de încărcare/descărcare care recalibrează nivelul de încărcare afișat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν αποκαθιστά τα στοιχεία της μπαταρίας. Είναι μια μακρά διαδικασία φόρτισης/εκφόρτισης που επαναβαθμονομεί το εμφανιζόμενο επίπεδο φόρτισης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не восстанавливает элементы батареи. Это длительная процедура зарядки/разрядки, которая заново калибрует отображаемый уровень заряда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не відновлює елементи акумулятора. Це тривала процедура заряджання/розряджання, яка повторно калібрує відображюваний рівень заряду."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, pil hücrelerini eski haline getirmez. Görüntülenen şarj seviyesini yeniden kalibre eden uzun bir şarj/deşarj işlemidir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يُصلح خلايا البطارية. إنه إجراء طويل من الشحن والتفريغ يعيد معايرة مستوى الشحن المعروض."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא משחזר את תאי הסוללה. זהו תהליך טעינה/פריקה ארוך שמכייל מחדש את רמת הטעינה המוצגת."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานนี้ไม่ได้ฟื้นฟูเซลล์แบตเตอรี่ แต่เป็นขั้นตอนชาร์จ/คายประจุที่ใช้เวลานาน เพื่อปรับเทียบระดับการชาร์จที่แสดงผลใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng này không phục hồi các cell pin. Đây là một quy trình sạc/xả kéo dài nhằm hiệu chuẩn lại mức sạc hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur ini tidak memulihkan sel baterai. Ini adalah prosedur pengisian/pengosongan daya yang panjang untuk mengalibrasi ulang level daya yang ditampilkan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैटरी सेल को पुनर्स्थापित नहीं करता है। यह एक लंबी चार्ज/डिस्चार्ज प्रक्रिया है जो दिखाए गए चार्ज स्तर को फिर से कैलिब्रेट करती है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不会修复电池芯，而是通过一次长时间的充放电流程，重新校准显示的电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不會修復電池芯，而是透過一次長時間的充放電流程，重新校準顯示的電量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 셀을 회복시키는 기능이 아니라, 잔량 표시의 추정 오차를 보정하는 장시간 충·방전 절차입니다."
          }
        }
      }
    },
