    "메뉴바 상주 시 24 fps, 앱 활성화 시 48 fps 고주사율로 ProMotion 화면에서 자연스럽고 균형 잡힌 모션을 제공합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바 상주 시 24 fps, 앱 활성화 시 48 fps 고주사율로 ProMotion 화면에서 자연스럽고 균형 잡힌 모션을 제공합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs at 24 fps idle, 48 fps active for natural, balanced motion on ProMotion displays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー常駐時は24 fps、アプリ操作時は48 fpsの高リフレッシュレートで、ProMotionディスプレイにおいて自然でバランスの取れた動きを提供します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常驻菜单栏时为24 fps，激活应用时为48 fps高刷新率，在ProMotion屏幕上提供自然平衡的动态效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常駐選單列時為24 fps，啟用App時為48 fps高更新頻率，在ProMotion螢幕上提供自然平衡的動態效果。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft mit 24 fps im Ruhezustand und 48 fps bei aktiver App für natürliche, ausgewogene Bewegung auf ProMotion-Displays."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne à 24 ips au repos et 48 ips en activité pour un mouvement naturel et équilibré sur les écrans ProMotion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona a 24 fps en reposo y 48 fps activo para un movimiento natural y equilibrado en pantallas ProMotion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona a 24 fps a riposo e 48 fps attivo per un movimento naturale ed equilibrato sui display ProMotion."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa a 24 fps em repouso e 48 fps ativo para movimentos naturais e equilibrados em telas ProMotion."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona a 24 fps em repouso e 48 fps ativo para um movimento natural e equilibrado em ecrãs ProMotion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait op 24 fps in rust en 48 fps actief voor een natuurlijke, evenwichtige beweging op ProMotion-schermen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs med 24 bps i viloläge och 48 bps vid aktivitet för naturliga och balanserade rörelser på ProMotion-skärmar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører med 24 bps i dvale og 48 bps ved aktivitet for en naturlig, afbalanceret bevægelse på ProMotion-skærme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii 24 fps taustalla ja 48 fps aktiivisena tarjoten luonnollisen ja tasapainoisen liikkeen ProMotion-näytöillä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører med 24 bps i hvile og 48 bps når aktiv for naturlige, balanserte bevegelser på ProMotion-skjermer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa z prędkością 24 kl./s w spoczynku i 48 kl./s po aktywacji, zapewniając naturalny i zrównoważony ruch na ekranach ProMotion."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží při 24 fps v nečinnosti a 48 fps při aktivitě pro přirozený a vyvážený pohyb na displejích ProMotion."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "24 fps sebességgel fut tétlen állapotban és 48 fps-sel aktív állapotban a természetes, kiegyensúlyozott mozgásért a ProMotion kijelzőkön."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează la 24 fps în repaus și 48 fps activ pentru o mișcare naturală și echilibrată pe ecranele ProMotion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργεί στα 24 fps σε αδράνεια και 48 fps όταν είναι ενεργό, προσφέροντας φυσική και ισορροπημένη κίνηση σε οθόνες ProMotion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает с частотой 24 кадр/с в покое и 48 кадр/с при активности, обеспечивая естественное и сбалансированное движение на дисплеях ProMotion."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює з частотою 24 кадр/с у стані спокою та 48 кадр/с при активності, забезпечуючи природний та збалансований рух на екранах ProMotion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ProMotion ekranlarda doğal ve dengeli hareket için boştayken 24 fps, etkinken 48 fps yüksek yenileme hızında çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل بمعدل 24 إطارًا/ثانية في وضع الخمول و48 إطارًا/ثانية عند النشاط لتوفير حركة طبيعية ومتوازنة على شاشات ProMotion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל ב-24 fps בהמתנה וב-48 fps בפעילות לתנועה טבעית ומאוזנת במסכי ProMotion."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานที่ 24 fps ขณะไม่ได้ใช้งาน และ 48 fps เมื่อใช้งานเพื่อการเคลื่อนไหวที่ดูเป็นธรรมชาติและสมดุลบนจอภาพ ProMotion"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy ở mức 24 fps khi không hoạt động, 48 fps khi hoạt động để mang lại chuyển động tự nhiên, cân bằng trên màn hình ProMotion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan pada 24 fps saat tidak aktif, 48 fps saat aktif untuk gerakan yang alami dan seimbang pada layar ProMotion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ProMotion डिस्प्ले पर प्राकृतिक, संतुलित गति के लिए निष्क्रिय होने पर 24 fps, सक्रिय होने पर 48 fps पर चलता है।"
          }
        }
      }
    },
    "메뉴바 상주 시 24 fps, 앱 활성화 시 60 fps 최고 주사율로 극도로 부드러운 고주사율 화면을 제공합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바 상주 시 24 fps, 앱 활성화 시 60 fps 최고 주사율로 극도로 부드러운 고주사율 화면을 제공합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
