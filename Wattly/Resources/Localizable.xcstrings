    "모든 설정값, 캐시, 백그라운드 팬 제어 도우미 및 앱이 시스템에서 완전히 제거되고 앱이 종료됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة جميع التفضيلات وذاكرة التخزين المؤقت ومساعد التحكم في المروحة في الخلفية والتطبيق بالكامل من النظام وسيتم إنهاء التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny předvolby, mezipaměti, pomocník pro řízení ventilátorů na pozadí a aplikace budou zcela odstraněny ze systému a aplikace se ukončí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle indstillinger, cache, baggrundshjælpeprogram til blæserstyring og appen fjernes fuldstændigt fra systemet, og appen afsluttes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen, Caches, der Hintergrund-Lüftersteuerungs-Helfer und die App werden vollständig vom System entfernt und die App wird beendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι προτιμήσεις, οι προσωρινές μνήμες, ο βοηθός ελέγχου ανεμιστήρα παρασκηνίου και η εφαρμογή θα αφαιρεθούν πλήρως από το σύστημα και η εφαρμογή θα τερματιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All preferences, caches, background fan control helper, and application will be completely removed from the system and the app will quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las preferencias, cachés, el asistente de control de ventilador en segundo plano y la aplicación se eliminarán por completo del sistema y la app se cerrará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki asetukset, välimuistit, taustan tuuletinohjauksen apuohjelma ja sovellus poistetaan kokonaan järjestelmästä ja sovellus sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages, caches, l'assistant de contrôle du ventilateur en arrière-plan et l'application seront complètement supprimés du système et l'application se fermera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההגדרות, המטמונים, מסייע בקרת המאוורר ברקע והאפליקציה יוסרו לחלוטין מהמערכת והאפליקציה תיסגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी प्राथमिकताएं, कैश, पृष्ठभूमि पंखा नियंत्रण सहायक और ऐप सिस्टम से पूरी तरह से हटा दिए जाएंगे और ऐप बंद हो जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítás, gyorsítótár, háttérbeli ventilátorvezérlő segéd és az alkalmazás teljesen eltávolításra kerül a rendszerből, és az alkalmazás kilép."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua preferensi, cache, pembantu kontrol kipas latar belakang, dan aplikasi akan dihapus sepenuhnya dari sistem dan aplikasi akan ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le preferenze, le cache, l'assistente di controllo ventole in background e l'applicazione verranno rimossi completamente dal sistema e l'app verrà chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定値、キャッシュ、バックグラウンドファン制御ヘルパー、およびアプリがシステムから完全に削除され、アプリが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정값, 캐시, 백그라운드 팬 제어 도우미 및 앱이 시스템에서 완전히 제거되고 앱이 종료됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle innstillinger, buffere, hjelpeprogram for viftestyring i bakgrunnen og appen fjernes fullstendig fra systemet, og appen avsluttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle voorkeuren, caches, achtergrondventilator-helper en de applicatie worden volledig van het systeem verwijderd en de app wordt afgesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie preferencje, pamięci podręczne, pomocnik sterowania wentylatorem w tle oraz aplikacja zostaną całkowicie usunięte z systemu, a program zostanie zamknięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as preferências, caches, assistente de ventoinha em segundo plano e o aplicativo serão completamente removidos do sistema e o app será encerrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as preferências, caches, assistente de ventoinha em segundo plano e a aplicação serão completamente removidos do sistema e a app será encerrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate preferințele, cache-urile, asistentul de control al ventilatorului din fundal și aplicația vor fi eliminate complet din sistem, iar aplicația se va închide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки, кэши, фоновый помощник управления вентиляторами и само приложение будут полностью удалены из системы, после чего приложение завершит работу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla inställningar, cacheminnen, bakgrundshjälpprogram för fläktstyrning och appen tas bort helt från systemet och appen avslutas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า แคช ตัวช่วยควบคุมพัดลมในพื้นหลัง และแอปพลิเคชันทั้งหมดจะถูกลบออกจากระบบโดยสมบูรณ์ และแอปจะปิดตัวลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm tercihler, önbellekler, arka plan fan kontrol yardımcısı ve uygulama sistemden tamamen kaldırılacak ve uygulama kapatılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі параметри, кеші, фоновий помічник керування вентиляторами та сама програма будуть повністю видалені із системи, після чого програма завершить роботу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tùy chọn, bộ nhớ đệm, trình hỗ trợ quạt nền và ứng dụng sẽ bị xóa hoàn toàn khỏi hệ thống và ứng dụng sẽ thoát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有偏好设置、缓存、后台风扇控制帮助程序和应用程序都将从系统中彻底删除，且应用程序将退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有偏好設定、快取、背景風扇控制輔助程式和應用程式都將從系統中徹底刪除，且應用程式將結束。"
          }
        }
      }
    },
    "모든 지표를 카드로 세로 배치하며 세부 펼침과 순서 변경을 지원합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지표를 카드로 세로 배치하며 세부 펼침과 순서 변경을 지원합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays all metrics vertically in expandable and reorderable cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての指標をカードとして縦に配置し、詳細の展開や順序の変更に対応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以垂直卡片形式显示所有指标，支持展开详情和重新排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以垂直卡片形式顯示所有指標，支援展開詳細資訊與重新排序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt alle Messwerte vertikal in ausklappbaren und neu anordenbaren Karten an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche toutes les mesures verticalement dans des cartes extensibles et réorganisables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todas las métricas verticalmente en tarjetas desplegables y reordenables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutte le metriche verticalmente in schede espandibili e riordinabili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe todas as métricas verticalmente em cartões expansíveis e reordenáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresenta todas as métricas verticalmente em cartões expansíveis e reordenáveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alle statistieken verticaal in uitklapbare en herordenbare kaarten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar alla mätvärden vertikalt i kort som kan fällas ut och ordnas om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alle målinger lodret i kort, der kan udvides og omarrangeres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kaikki mittarit pystysuunnassa laajennettavissa ja uudelleenjärjesteltävissä korteissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alle målinger vertikalt i kort som kan utvides og omorganiseres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla wszystkie wskaźniki pionowo na rozwijanych kartach z możliwością zmiany kolejności."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje všechny metriky svisle v rozbalitelných kartách s možností změny pořadí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes mérőszámot függőlegesen jeleníti meg kibontható és átrendezhető kártyákban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează toate valorile vertical în carduri expandabile și reordonabile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει όλες τις μετρήσεις κατακόρυφα σε επεκτεινόμενες κάρτες με δυνατότητα αναδιάταξης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает все показатели вертикально в раскрываемых карточках с возможностью изменения порядка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображає всі показники вертикально в розгортаних картках із можливістю зміни порядку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm metrikleri genişletilebilir ve yeniden sıralanabilir kartlar halinde dikey olarak görüntüler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جميع المقاييس رأسيًا في بطاقات قابلة للتوسيع وإعادة الترتيب."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את כל המדדים אנכית בכרטיסים הניתנים להרחבה ולסידור מחדש."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวชี้วัดทั้งหมดในแนวตั้งในการ์ดที่สามารถขยายและจัดลำดับใหม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tất cả chỉ số theo chiều dọc trong các thẻ có thể mở rộng và sắp xếp lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan semua metrik secara vertikal dalam kartu yang dapat diperluas dan diatur ulang urutannya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी मेट्रिक्स को लंबवत रूप से विस्तार योग्य और पुन: व्यवस्थित करने योग्य कार्डों में प्रदर्शित करता है।"
          }
        }
      }
    },
