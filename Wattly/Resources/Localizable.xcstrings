        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wznowić ładowania (spróbuj ponownie podłączyć zasilacz)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabíjení se nepodařilo obnovit (zkuste znovu připojit napájecí adaptér)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A töltés folytatása sikertelen (csatlakoztassa újra a hálózati adaptert)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reluarea încărcării a eșuat (încearcă să reconectezi adaptorul de alimentare)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η συνέχιση της φόρτισης (δοκιμάστε να επανασυνδέσετε τον προσαρμογέα ρεύματος)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось возобновить зарядку (попробуйте снова подключить адаптер питания)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
