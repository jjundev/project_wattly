    "메뉴바 아이콘 옆에 선택한 지표를 함께 표시합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴바 아이콘 옆에 선택한 지표를 함께 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays selected metrics alongside the menu bar icon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンの横に選択した指標を並べて表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏图标旁同时显示所选指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列圖示旁同時顯示所選指標。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt ausgewählte Messwerte neben dem Menüleistensymbol an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les mesures sélectionnées à côté de l'icône de la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las métricas seleccionadas junto al icono de la barra de menús."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le metriche selezionate accanto all'icona della barra dei menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe as métricas selecionadas ao lado do ícone da barra de menus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresenta as métricas selecionadas ao lado do ícone da barra de menus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont geselecteerde statistieken naast het menubalksymbool."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar valda mätvärden bredvid menyradsikonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser valgte målinger ved siden af menulinjeikonet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
