    "아날로그 전력 계측기 바늘이 전력량에 맞춰 기민하게 스윙합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتأرجح مؤشر مقياس الطاقة التناظري بسرعة استجابة لاستهلاك الطاقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručička analogového wattmetru pružně kmitá podle spotřeby energie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den analoge effektmålernål svinger responsivt efter strømforbruget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nadel des analogen Leistungsmessers schlägt reaktionsschnell je nach Stromverbrauch aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βελόνα του αναλογικού μετρητή ισχύος κινείται ευέλικτα ανάλογα με την κατανάλωση ισχύος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The analog power meter needle swings responsively to power consumption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aguja del medidor de energía analógico oscila con agilidad según el consumo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analogisen tehomittarin neula heilahtelee herkästi virrankulutuksen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aiguille du wattmètre analogique oscille de manière réactive selon la consommation d'énergie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחט מד ההספק האנלוגי נעה בגמישות בהתאם לצריכת החשמל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एनालॉग पावर मीटर की सुई बिजली की खपत के अनुसार तेजी से घूमती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az analóg teljesítménymérő mutatója dinamikusan kileng az áramfogyasztásnak megfelelően."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarum meteran daya analog berayun secara responsif terhadap konsumsi daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lancetta del misuratore di potenza analogico oscilla prontamente in base al consumo energetico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アナログ電力メーターの針が電力量に合わせて俊敏にスイングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아날로그 전력 계측기 바늘이 전력량에 맞춰 기민하게 스윙합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den analoge effektmålernålen svinger responsivt i takt med strømforbruket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naald van de analoge vermogensmeter zwaait responsief mee met het stroomverbruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka analogowego miernika mocy dynamicznie reaguje na poziom zużycia energii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponteiro do medidor analógico de energia oscila agilmente de acordo com o consumo de energia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponteiro do medidor analógico de energia oscila agilmente de acordo com o consumo de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acul contorului analogic de putere oscilează rapid în funcție de consumul de energie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелка аналогового ваттметра чутко реагирует на уровень энергопотребления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den analoga effektmätarnålen rör sig följsamt efter strömförbrukningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มมิเตอร์วัดพลังงานแบบแอนะล็อกจะแกว่งอย่างรวดเร็วตามปริมาณการใช้พลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analog güç ölçer ibresi, güç tüketimine göre hassas şekilde hareket eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрілка аналогового ватметра чутливо коливається відповідно до рівня споживання електроенергії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim đồng hồ đo điện analog chuyển động linh hoạt theo lượng điện tiêu thụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟功率计指针随电量灵敏摆动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "類比功率計指針隨電量靈敏擺動。"
          }
        }
      }
    },
