    "유지보수: 저장된 충전 정책을 읽지 못해 충전 허용 상태로 복구합니다": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة سياسة الشحن المخزنة إلى حالة تسمح بالشحن لأنه لا يمكن قراءتها"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovte uložené zásady nabíjení do stavu, který umožňuje nabíjení, protože jej nelze přečíst"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan den gemte opladningspolitik til en tilstand, der tillader opladning, fordi den ikke kunne læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die gespeicherte Ladungsrichtlinie in einen Zustand zurück, der das Laden ermöglicht, da sie nicht gelesen werden konnte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρετε την αποθηκευμένη πολιτική φόρτισης σε κατάσταση που επιτρέπει τη φόρτιση επειδή δεν ήταν δυνατή η ανάγνωσή της"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored charge policy could not be read; charging will be restored"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure la política de carga almacenada a un estado que permita la carga porque no se pudo leer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta tallennettu latauskäytäntö tilaan, joka sallii latauksen, koska sitä ei voitu lukea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir la politique de charge stockée dans un état qui permet la charge car elle n'a pas pu être lue"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחזר את מדיניות הטעינה המאוחסנת למצב המאפשר טעינה מכיוון שלא ניתן היה לקרוא אותה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहीत चार्जिंग नीति को उस राज्य में पुनर्स्थापित करें जो चार्ज करने की अनुमति देता है क्योंकि इसे पढ़ा नहीं जा सकता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa vissza a tárolt töltési szabályzatot olyan állapotba, amely lehetővé teszi a töltést, mert nem olvasható"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembalikan kebijakan pengisian daya yang tersimpan ke keadaan yang memungkinkan pengisian daya karena tidak dapat dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina la politica di ricarica memorizzata in uno stato che consenta la ricarica perché non può essere letta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された課金ポリシーを、読み取ることができなかったために課金を許可する状態に復元する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 충전 정책을 읽지 못해 충전 허용 상태로 복구합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke lese den lagrede ladepolicyen. Gjenopprett til tillatt ladestatus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel het opgeslagen oplaadbeleid naar een staat die opladen toestaat omdat het niet kon worden gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć zapisaną politykę ładowania do stanu, który pozwala na ładowanie, ponieważ nie można jej odczytać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure a política de carregamento armazenada para um estado que permita o carregamento porque não pôde ser lida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure a política de carregamento armazenada para um estado que permita o carregamento porque não pôde ser lida"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabiliți politica de încărcare stocată la o stare care permite încărcarea deoarece nu a putut fi citită"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите сохраненную политику зарядки до состояния, которое позволяет зарядку, поскольку ее нельзя прочитать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ den lagrade laddningspolicyn till ett tillstånd som tillåter laddning eftersom den inte kunde läsas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่านโยบายการชาร์จที่จัดเก็บไว้ให้อยู่ในสถานะที่อนุญาตให้ชาร์จได้เนื่องจากไม่สามารถอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen şarj politikasını, okunamadığı için şarja izin veren bir duruma geri yükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення збереженої політики заряджання до стану, який дозволяє заряджати, оскільки її неможливо прочитати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục chính sách sạc được lưu trữ về trạng thái cho phép sạc vì không thể đọc được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将存储的收费策略恢复到允许收费的状态，因为它无法读取"
