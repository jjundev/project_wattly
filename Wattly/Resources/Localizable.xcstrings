    "다른 사용자가 이 Mac의 충전 정책을 관리하고 있습니다": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자가 이 Mac의 충전 정책을 관리하고 있습니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another user manages this Mac's charge policy"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدم آخر يدير سياسة الشحن لهذا الـ Mac"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady nabíjení tohoto Macu spravuje jiný uživatel"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden bruger administrerer opladningspolitikken på denne Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Benutzer verwaltet die Laderichtlinie auf diesem Mac"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άλλος χρήστης διαχειρίζεται την πολιτική φόρτισης σε αυτό το Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro usuario administra la política de carga de este Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen käyttäjä hallinnoi tämän Macin latauskäytäntöä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre utilisateur gère la politique de charge de ce Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש אחר מנהל את מדיניות הטעינה של Mac זה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अन्य उपयोगकर्ता इस Mac की चार्ज नीति का प्रबंधन कर रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik felhasználó kezeli a Mac töltési házirendjét"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna lain mengelola kebijakan pengisian daya di Mac ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro utente gestisce i criteri di carica su questo Mac"
          }
        },
        "ja": {
