          }
        }
      }
    },
    "현재 배터리 잔량이 목표 잔량 이하입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 배터리 잔량이 목표 잔량 이하입니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery level is already at or below target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量がすでに目標値以下です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池电量已达到或低于目标值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池電量已達到或低於目標值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Batteriestand liegt bereits auf oder unter dem Ziel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau de la batterie est déjà au niveau cible ou en dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nivel de la batería ya está en el objetivo o por debajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il livello della batteria è già pari o inferiore all’obiettivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nível da bateria já está no alvo ou abaixo dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nível da bateria já está no alvo ou abaixo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень заряда уже равен целевому или ниже."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het batterijniveau is al gelijk aan of lager dan het doel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom baterii jest już na poziomie docelowym lub niższy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil düzeyi zaten hedefte veya altında."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterinivån är redan på eller under målet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteriniveauet er allerede på eller under målet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterinivået er allerede på eller under målet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun varaus on jo tavoitteessa tai sen alle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úroveň baterie je již na cílové hodnotě nebo pod ní."
          }
        },
        "hu": {
