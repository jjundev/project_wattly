            "state": "translated",
            "value": "Impossibile riprendere la ricarica (prova a ricollegare l'alimentatore)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível retomar o carregamento (tente reconectar o adaptador de energia)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
