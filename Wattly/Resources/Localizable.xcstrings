        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld opladning én gang fuldført (holder 100 %, vender tilbage til oprindelig grænse ved frakobling)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliges Vollladen abgeschlossen (100% wird gehalten, ursprüngliches Limit wird beim Trennen wiederhergestellt)"
