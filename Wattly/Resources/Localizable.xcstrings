    "관리자 인증이 취소되었거나 실패했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 인증이 취소되었거나 실패했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator authentication was cancelled or failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者認証がキャンセルされたか失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员身份验证已取消或失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理員身分驗證已取消或失敗。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Administratorauthentifizierung wurde abgebrochen oder ist fehlgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification de l'administrateur a été annulée ou a échoué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación del administrador se canceló o falló."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione dell'amministratore è stata annullata o non è riuscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação do administrador foi cancelada ou falhou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação de administrador foi cancelada ou falhou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beheerdersverificatie is geannuleerd of mislukt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratörsautentiseringen avbröts eller misslyckades."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorgodkendelsen blev annulleret eller mislykkedes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmänvalvojan todennus peruutettiin tai epäonnistui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorautentiseringen ble avbrutt eller mislyktes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie administratora zostało anulowane lub nie powiodło się."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření správce bylo zrušeno nebo se nezdařilo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszergazdai hitelesítés megszakadt vagy sikertelen volt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea administratorului a fost anulată sau a eșuat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο έλεγχος ταυτότητας διαχειριστή ακυρώθηκε ή απέτυχε."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация администратора отменена или не удалась."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікацію адміністратора скасовано або вона не вдалася."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici kimlik doğrulaması iptal edildi veya başarısız oldu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء مصادقة المسؤول أو فشلت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימות המנהל בוטל או נכשל."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนของผู้ดูแลระบบถูกยกเลิกหรือล้มเหลว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực quản trị viên đã bị hủy hoặc không thành công."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi administrator dibatalkan atau gagal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रशासक प्रमाणीकरण रद्द कर दिया गया या विफल हो गया।"
          }
        }
      }
    },
