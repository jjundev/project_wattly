          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar o executável do assistente no pacote da aplicação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitvoerbare helperbestand is niet gevonden in de app-bundel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att hitta hjälpprogrammets körbara fil i appaketet."
