    "다른 사용자의 충전 정책을 해제하고 이 사용자로 소유권을 이전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자의 충전 정책을 해제하고 이 사용자로 소유권을 이전합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the other user's charge policy and transfer ownership to this user."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرر سياسة الشحن للمستخدم الآخر وانقل الملكية إلى هذا المستخدم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolnit zásady nabíjení jiného uživatele a převést vlastnictví na tohoto uživatele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigør den anden brugers opladningspolitik og overfør ejerskab til denne bruger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laderichtlinie des anderen Benutzers aufheben und Besitz auf diesen Benutzer übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδέσμευση της πολιτικής φόρτισης άλλου χρήστη και μεταβίβαση κυριότητας σε αυτόν τον χρήστη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera la política de carga del otro usuario y transfiere la propiedad a este usuario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapauta toisen käyttäjän latauskäytäntö ja siirrä omistajuus tälle käyttäjälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez la politique de charge de l'autre utilisateur et transférez la propriété à cet utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחרר את מדיניות הטעינה של המשתמש האחר והעבר בעלות למשתמש זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य उपयोगकर्ता की चार्ज नीति को छोड़ें और स्वामित्व इस उपयोगकर्ता को स्थानांतरित करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A másik felhasználó töltési házirendjének feloldása és a tulajdonjog átruházása erre a felhasználóra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan kebijakan pengisian daya pengguna lain dan transfer kepemilikan ke pengguna ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia i criteri di carica dell'altro utente e trasferisci la proprietà a questo utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のユーザーの充電ポリシーを解除し、このユーザーに所有権を移行します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigi den andre brukerens laderegler og overfør eierskap til denne brukeren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het oplaadbeleid van de andere gebruiker los en draag het eigendom over aan deze gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwolnij zasady ładowania innego użytkownika i przenieś własność na tego użytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar a política de carga do outro usuário e transferir a propriedade para este usuário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Libertar a política de carregamento do outro utilizador e transferir a propriedade para este utilizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberați politica de încărcare a celuilalt utilizator și transferați proprietatea către acest utilizator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить политику зарядки другого пользователя и передать права текущему пользователю."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigör den andra användarens laddningspolicy och överför ägarskap till denna användare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดนโยบายการชาร์จของผู้ใช้อื่นและโอนความเป็นเจ้าของมายังผู้ใช้นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer kullanıcının şarj politikasını kaldırın ve sahipliği bu kullanıcıya aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути політику заряджання іншого користувача та передати права цьому користувачу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải phóng chính sách sạc của người dùng khác và chuyển quyền sở hữu cho người dùng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放其他用户的充电策略并将所有权转让给当前用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除其他使用者的充電政策並將所有權轉移給此使用者。"
          }
        }
      }
    },
