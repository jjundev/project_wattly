        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: Επιστροφή στις προεπιλεγμένες ελάχιστες RPM ή παραπάνω"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: Return to default minimum RPM or above"
