            "state": "translated",
            "value": "Оновлює активні показники кожні 5 секунд незалежно від стану панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel durumundan bağımsız olarak etkin metrikleri her 5 saniyede bir günceller."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّث المقاييس النشطة كل ٥ ثوانٍ بغض النظر عن حالة اللوحة."
          }
        },
        "he": {
          "stringUnit": {
