    "업데이트 앱 번들을 찾을 수 없습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على حزمة تطبيق التحديث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze najít balíček aktualizované aplikace."
          }
        },
