    "부하(0%~100%)에 따라 오르막 힘겨운 걸음 → 평지 조깅 → 내리막 폭풍 질주로 지형 경사와 캐릭터 자세가 연속 전환됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وفقًا للحمل (0%–100%)، ينتقل ميل التضاريس ووضعية الشخصية بسلاسة من تسلق شاق إلى هرولة على أرض مستوية ثم انطلاق سريع على المنحدر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle zatížení (0 %–100 %) plynule přechází sklon terénu a postoj postavy od náročného stoupání přes běh po rovině až po rychlý sjezd z kopca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhængigt af belastningen (0 %–100 %) skifter terrænhældning og figurstilling trinløst fra hård stigning til let løb på flad vej til hurtig spurt ned ad bakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nach Last (0%–100%) wechseln Geländeneigung und Haltung des Charakters fließend vom mühsamen Bergaufstieg über ebenes Joggen bis zum rasanten Bergabsprint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάλογα με το φορτίο (0%–100%), η κλίση του εδάφους και η στάση του χαρακτήρα μεταβαίνουν ομαλά από ανηφορικό βάδην σε τζόκινγκ σε επίπεδο έδαφος και γρήγορο σπριντ σε κατηφόρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terrain slope and character posture transition seamlessly from uphill struggle to flat jogging to downhill sprint based on load (0%–100%)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según la carga (0%-100%), la pendiente del terreno y la postura del personaje cambian fluidamente de subida esforzada a trote en llano y descenso a toda velocidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuormituksen (0 %–100 %) mukaan maaston kaltevuus ja hahmon asento siirtyvät saumattomasti raskaasta ylämäkikävelystä tasamaajuoksuun ja vauhdikkaaseen alamäkisp printtiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon la charge (0 %–100 %), la pente du terrain et la posture du personnage passent de manière fluide d'une montée difficile à un jogging sur le plat, puis à un sprint en descente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהתאם לעומס (0%–100%), שיפוע הקרקע ותנוחת הדמות משתנים ברציפות מעלייה מאומצת לריצה קלה במישור ועד לספרינט במורד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड (0%–100%) के अनुसार, इलाके का ढलान और चरित्र की मुद्रा कठिन चढ़ाई से लेकर सपाट जॉगिंग और नीचे की ओर तेज़ दौड़ में बदलती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A terheléstől függően (0%–100%) a terep lejtése és a karakter testtartása zökkenőmentesen változik a nehéz hegymenettől a síkfutáson át a lejtős vágtáig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan beban (0%–100%), kemiringan medan dan postur karakter beralih mulus dari mendaki tanjakan, joging di jalan datar, hingga meluncur kencang di turunan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base al carico (0%–100%), la pendenza del terreno e la postura del personaggio passano senza interruzioni da una faticosa salita a una corsa in piano fino a uno sprint in discesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負荷（0%〜100%）に応じて、地形の傾斜とキャラクターの姿勢が上り坂の力歩き→平地ジョギング→下り坂の猛ダッシュへと連続的に変化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부하(0%~100%)에 따라 오르막 힘겨운 걸음 → 평지 조깅 → 내리막 폭풍 질주로 지형 경사와 캐릭터 자세가 연속 전환됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avhengig av belastning (0 %–100 %) går terrengets helning og figurens holdning sømløst over fra tung oppoverbakke til jogging på flatmark til rask spurt nedover."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhankelijk van de belasting (0%–100%) wisselen de terreinhelling en personagehouding naadloos van zware bergopwaartse tred naar vlak joggen en een stormachtige afdaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zależności od obciążenia (0%–100%) nachylenie terenu i postawa postaci płynnie zmieniają się z mozolnego marszu pod górę w jogging po płaskim, a następnie w szybki bieg w dół."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conforme a carga (0%–100%), a inclinação do terreno e a postura do personagem mudam suavemente de subida íngreme para corrida em terreno plano e descida rápida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De acordo com a carga (0%–100%), a inclinação do terreno e a postura da personagem mudam suavemente de subida íngreme para corrida em terreno plano e descida rápida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În funcție de sarcină (0%–100%), panta terenului și postura personajului trec lin de la urcare grea la alergare pe teren plat și coborâre în viteză maximă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В зависимости от нагрузки (0%–100%) наклон рельефа и поза персонажа плавно меняются от тяжелого подъема в гору до бега по равнине и стремительного спуска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beroende på belastning (0 %–100 %) övergår terrängens lutning och karaktärens hållning smidigt från tung uppförsbacke till jogging på plan mark till snabb nedförsspurt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตามโหลดการทำงาน (0%–100%) ความชันของพื้นที่และท่าทางของตัวละครจะเปลี่ยนอย่างต่อเนื่องจากการเดินขึ้นเขาอย่างยากลำบาก → วิ่งเหยาะๆ บนทางราบ → วิ่งลงเขาอย่างรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüke (%0–%100) bağlı olarak arazi eğimi ve karakter duruşu, zorlu yokuş çıkışından düz yol koşusuna ve hızlı yokuş aşağı inişe doğru kesintisiz geçiş yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залежно від навантаження (0%–100%) нахил рельєфу та поза персонажа плавно змінюються від важкого підйому в гору до бігу рівниною та стрімкого спуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy theo tải (0%–100%), độ dốc địa hình và tư thế nhân vật sẽ chuyển đổi mượt mà từ bước đi leo dốc vất vả → chạy bộ đường bằng → chạy nước rút xuống dốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据负载 (0%–100%)，地形坡度和角色姿态会在吃力爬坡 → 平地慢跑 → 下坡疾速狂奔之间无缝切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據負載 (0%–100%)，地形坡度和角色姿態會在吃力爬坡 → 平地慢跑 → 下坡疾速狂奔之間無縫切換。"
          }
        }
      }
    },
