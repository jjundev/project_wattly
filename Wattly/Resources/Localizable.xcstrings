    "텍스트 표시를 켜면 선택한 지표가 아이콘 옆에 표시됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 표시를 켜면 선택한 지표가 아이콘 옆에 표시됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Show Text is enabled, selected metrics will appear next to the icon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「テキストを表示」をオンにすると、選択した指標がアイコンの横に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“显示文本”后，所选指标将显示在图标旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「顯示文字」後，所選指標將顯示在圖示旁邊。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn „Text anzeigen“ aktiviert ist, erscheinen die ausgewählten Messwerte neben dem Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l'option Afficher le texte est activée, les mesures sélectionnées apparaissent à côté de l'icône."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando «Mostrar texto» esté activado, las métricas seleccionadas aparecerán junto al icono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando «Mostra testo» è abilitato, le metriche selezionate compariranno accanto all'icona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando «Mostrar Texto» estiver ativado, as métricas selecionadas aparecerão ao lado do ícone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando «Mostrar texto» estiver ativado, as métricas selecionadas surgem ao lado do ícone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer „Toon tekst“ is ingeschakeld, verschijnen de geselecteerde statistieken naast het symbool."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När Visa text är aktiverat visas de valda mätvärdena bredvid ikonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Vis tekst er aktiveret, vises de valgte målinger ved siden af ikonet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Näytä teksti on käytössä, valitut mittarit näkyvät kuvakkeen vieressä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Vis tekst er aktivert, vises de valgte målingene ved siden av ikonet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy włączona jest opcja Pokaż tekst, wybrane wskaźniki będą wyświetlane obok ikony."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je zapnuto Zobrazit text, vybrané metriky se zobrazí vedle ikony."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Szöveg megjelenítése bekapcsolásakor a kiválasztott mérőszámok megjelennek az ikon mellett."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când opțiunea Afișare text este activată, valorile selectate vor apărea lângă pictogramă."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η επιλογή Εμφάνιση κειμένου είναι ενεργοποιημένη, οι επιλεγμένες μετρήσεις θα εμφανίζονται δίπλα στο εικονίδιο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении параметра «Показывать текст» выбранные показатели отображаются рядом со значком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ввімкнено опцію «Показувати текст», вибрані показники з'являтимуться поруч зі значком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni Göster etkinleştirildiğinde seçilen metrikler simgenin yanında görünür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تمكين إظهار النص، ستظهر المقاييس المحددة بجوار الأيقونة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר 'הצג טקסט' מופעל, המדדים שנבחרו יופיעו לצד הסמל."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งานแสดงข้อความ ตัวชี้วัดที่เลือกจะปรากฏถัดจากไอคอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật Hiển thị văn bản, các chỉ số đã chọn sẽ xuất hiện cạnh biểu tượng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Tampilkan Teks diaktifkan, metrik yang dipilih akan muncul di sebelah ikon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट दिखाएं सक्षम होने पर, चयनित मेट्रिक्स आइकन के बगल में दिखाई देंगे।"
          }
        }
      }
    },
