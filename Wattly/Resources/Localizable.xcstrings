    "3. '최적화된 배터리 충전' 끄기": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3. أوقف تشغيل 'شحن البطارية المحسّن'"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Vypněte „Optimalizované nabíjení baterie“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Slå 'Optimeret batteriopladning' fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Deaktivieren Sie „Optimiertes Laden der Batterie“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Απενεργοποιήστε τη «Βελτιστοποιημένη φόρτιση μπαταρίας»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Turn off 'Optimized Battery Charging'"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Desactiva 'Recarga optimizada'"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Poista 'Optimoitu akun lataus' käytöstä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Désactivez « Recharge optimisée de la batterie »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "3. כבה את 'טעינת סוללה מותאמת'"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 'अनुकूलित बैटरी चार्जिंग' बंद करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Kapcsolja ki az „Optimalizált akkutöltés” funkciót"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Matikan 'Pengisian Daya Baterai Optimal'"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Disattiva 'Caricamento ottimizzato'"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 「バッテリー充電の最適化」をオフにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. '최적화된 배터리 충전' 끄기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Slå av «Optimert batterilading»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Schakel 'Geoptimaliseerd opladen' uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Wyłącz opcję „Zoptymalizowane ładowanie”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Desative o 'Carregamento Otimizado'"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Desative o 'Carregamento otimizado'"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dezactivați „Încărcare optimizată a bateriei”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Отключите «Оптимизированная зарядка»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Stäng av 'Optimerad batteriladdning'"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3. ปิด 'การชาร์จเพื่อถนอมแบตเตอรี่'"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 'İyileştirilmiş Pil Şarjı' özelliğini kapatın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Вимкніть «Оптимізоване заряджання»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Tắt 'Sạc pin được tối ưu hóa'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 关闭“优化电池充电”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 關閉「最佳化電池充電」"
          }
