    "설정한 한도에 도달하면 충전을 멈추고 전원 어댑터로만 작동하여 배터리 수명을 보호합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 한도에 도달하면 충전을 멈추고 전원 어댑터로만 작동하여 배터리 수명을 보호합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops charging at your limit and runs from the power adapter to protect battery lifespan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した上限に達すると充電を停止し、電源アダプタのみで動作してバッテリー寿命を保護します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到设定的上限后停止充电，仅通过电源适配器供电，以保护电池寿命。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到設定的上限後停止充電，僅透過電源轉接器供電，以保護電池壽命。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt das Laden bei deinem Limit und läuft über das Netzteil, um die Akkulebensdauer zu schützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la charge à la limite définie et fonctionne sur l'adaptateur secteur pour préserver la durée de vie de la batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la carga al alcanzar tu límite y funciona con el adaptador de corriente para proteger la vida útil de la batería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe la ricarica al raggiungimento del limite e funziona tramite l'alimentatore per proteggere la durata della batteria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe o carregamento no seu limite e funciona com o adaptador de energia para proteger a vida útil da bateria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe o carregamento no limite definido e funciona a partir do transformador para proteger a vida útil da bateria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt met opladen bij je limiet en werkt op de stroomadapter om de levensduur van de accu te beschermen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutar ladda vid din gräns och drivs via strömadaptern för att skydda batteriets livslängd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper opladningen ved din grænse og kører på strømadapteren for at beskytte batteriets levetid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopettaa lataamisen asetetussa rajassa ja toimii virtalähteellä akun käyttöiän suojaamiseksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper ladingen ved grensen din og kjører på strømadapteren for å beskytte batteriets levetid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje ładowanie po osiągnięciu limitu i działa na zasilaczu, aby chronić żywotność baterii."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dosažení limitu zastaví nabíjení a běží z napájecího adaptéru, aby chránil životnost baterie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A töltés leáll a beállított korlátnál, és a készülék a hálózati adapterről működik az akkumulátor élettartamának védelme érdekében."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește încărcarea la limita stabilită și funcționează de la adaptorul de alimentare pentru a proteja durata de viață a bateriei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταματά τη φόρτιση όταν φτάσει στο όριό σας και λειτουργεί μέσω του προσαρμογέα ρεύματος για την προστασία της διάρκειας ζωής της μπαταρίας."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает зарядку при достижении заданного лимита и работает от адаптера питания для защиты срока службы батареи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє заряджання після досягнення заданого ліміту та працює від адаптера живлення, щоб захистити термін служби акумулятора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlediğiniz sınıra ulaşıldığında şarjı durdurur ve pil ömrünü korumak için güç adaptöründen çalışır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الشحن عند بلوغ الحد الذي حددته، ويعمل عبر محول الطاقة لحماية عمر البطارية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצר את הטעינה בהגיעו למגבלה שהגדרת ופועל ממתאם המתח כדי להגן על אורך חיי הסוללה."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดการชาร์จเมื่อถึงขีดจำกัดที่ตั้งไว้ และทำงานด้วยอะแดปเตอร์ไฟฟ้าเพื่อปกป้องอายุการใช้งานแบตเตอรี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng sạc khi đạt đến giới hạn của bạn và chạy bằng bộ chuyển đổi nguồn để bảo vệ tuổi thọ pin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan pengisian daya pada batas yang Anda tetapkan dan berjalan dari adaptor daya untuk melindungi masa pakai baterai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी निर्धारित सीमा पर चार्जिंग रोकता है और बैटरी की उम्र सुरक्षित रखने के लिए पावर एडाप्टर से चलता है।"
          }
        }
      }
    },
