    "절차: 100% 충전 → 20% 방전 → 10분 대기 → 100% 재충전 → 60분 대기 → 원래 설정 복원": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps: charge to 100% → discharge to 20% → wait 10 min → recharge to 100% → wait 60 min → restore your settings"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte: auf 100 % laden → auf 20 % entladen → 10 Min. warten → erneut auf 100 % laden → 60 Min. warten → deine Einstellungen wiederherstellen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順：100%まで充電 → 20%まで放電 → 10分待機 → 再び100%まで充電 → 60分待機 → 元の設定に戻す"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étapes : charger à 100 % → décharger à 20 % → attendre 10 min → recharger à 100 % → attendre 60 min → restaurer vos réglages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos: cargar al 100 % → descargar al 20 % → esperar 10 min → recargar al 100 % → esperar 60 min → restaurar tu configuración"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggi: carica al 100% → scarica al 20% → attendi 10 min → ricarica al 100% → attendi 60 min → ripristina le tue impostazioni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapas: carregar até 100% → descarregar até 20% → aguardar 10 min → recarregar até 100% → aguardar 60 min → restaurar suas configurações"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapas: carregar até 100% → descarregar até 20% → aguardar 10 min → recarregar até 100% → aguardar 60 min → restaurar as suas definições"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stappen: opladen tot 100% → ontladen tot 20% → 10 min wachten → opnieuw opladen tot 100% → 60 min wachten → je instellingen herstellen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg: ladda till 100 % → ladda ur till 20 % → vänta 10 min → ladda till 100 % igen → vänta 60 min → återställ dina inställningar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trin: oplad til 100 % → aflad til 20 % → vent 10 min → genoplad til 100 % → vent 60 min → gendan dine indstillinger"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaiheet: lataa 100 %:iin → pura 20 %:iin → odota 10 min → lataa uudelleen 100 %:iin → odota 60 min → palauta asetuksesi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinn: lad til 100 % → lad ut til 20 % → vent 10 min → lad til 100 % igjen → vent 60 min → gjenopprett innstillingene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroki: naładuj do 100% → rozładuj do 20% → czekaj 10 min → naładuj ponownie do 100% → czekaj 60 min → przywróć swoje ustawienia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroky: nabít na 100 % → vybít na 20 % → čekat 10 min → znovu nabít na 100 % → čekat 60 min → obnovit vaše nastavení"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépések: töltés 100%-ig → merítés 20%-ig → várakozás 10 percig → ismételt töltés 100%-ig → várakozás 60 percig → beállítások visszaállítása"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pași: încarcă până la 100% → descarcă până la 20% → așteaptă 10 min → reîncarcă până la 100% → așteaptă 60 min → restaurează setările tale"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βήματα: φόρτιση έως 100% → εκφόρτιση έως 20% → αναμονή 10 λεπτών → επαναφόρτιση έως 100% → αναμονή 60 λεπτών → επαναφορά των ρυθμίσεών σας"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этапы: зарядка до 100% → разрядка до 20% → ожидание 10 мин → повторная зарядка до 100% → ожидание 60 мин → восстановление ваших настроек"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Етапи: заряджання до 100% → розряджання до 20% → очікування 10 хв → повторне заряджання до 100% → очікування 60 хв → відновлення ваших налаштувань"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımlar: %100'e şarj → %20'ye deşarj → 10 dk bekle → tekrar %100'e şarj → 60 dk bekle → ayarlarını geri yükle"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطوات: الشحن حتى 100% → التفريغ حتى 20% → الانتظار 10 دقائق → إعادة الشحن حتى 100% → الانتظار 60 دقيقة → استعادة إعداداتك"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלבים: טעינה עד 100% → פריקה עד 20% → המתנה 10 דקות → טעינה חוזרת עד 100% → המתנה 60 דקות → שחזור ההגדרות שלך"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอน: ชาร์จถึง 100% → คายประจุถึง 20% → รอ 10 นาที → ชาร์จถึง 100% อีกครั้ง → รอ 60 นาที → คืนค่าการตั้งค่าของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước: sạc đến 100% → xả đến 20% → chờ 10 phút → sạc lại đến 100% → chờ 60 phút → khôi phục cài đặt của bạn"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah-langkah: isi daya hingga 100% → kosongkan daya hingga 20% → tunggu 10 mnt → isi ulang daya hingga 100% → tunggu 60 mnt → pulihkan pengaturan Anda"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण: 100% तक चार्ज करें → 20% तक डिस्चार्ज करें → 10 मिनट प्रतीक्षा करें → फिर से 100% तक चार्ज करें → 60 मिनट प्रतीक्षा करें → अपनी सेटिंग्स पुनर्स्थापित करें"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步骤：充电至 100% → 放电至 20% → 等待 10 分钟 → 再次充电至 100% → 等待 60 分钟 → 恢复你的设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步驟：充電至 100% → 放電至 20% → 等待 10 分鐘 → 再次充電至 100% → 等待 60 分鐘 → 還原你的設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절차: 100% 충전 → 20% 방전 → 10분 대기 → 100% 재충전 → 60분 대기 → 원래 설정 복원"
          }
        }
      }
    },
