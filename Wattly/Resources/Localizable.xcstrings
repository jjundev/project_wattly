        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть адаптер живлення, щоб почати розрядку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออะแดปเตอร์ไฟเพื่อเริ่มการคายประจุ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bộ đổi nguồn để bắt đầu xả."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan adaptor daya untuk memulai pengosongan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्चार्ज शुरू करने के लिए पावर अडैप्टर कनेक्ट करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
