    "유지보수: 설치된 도우미의 소유자 정보를 확인할 수 없습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديد معلومات المالك للمساعد المثبت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze určit informace o vlastníkovi nainstalovaného pomocníka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke bestemme ejeroplysninger for installeret hjælper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eigentümerinformationen für den installierten Helfer können nicht ermittelt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατός ο προσδιορισμός των στοιχείων κατόχου για τον εγκατεστημένο βοηθό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify the installed helper's ownership."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede determinar la información del propietario del ayudante instalado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennetun apulaisen omistajatietoja ei voida määrittää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer les informations du propriétaire pour l'assistant installé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקבוע את פרטי הבעלים של העוזר המותקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए हेल्पर के लिए मालिक की जानकारी निर्धारित करने में असमर्थ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem lehet meghatározni a telepített segítő tulajdonosi adatait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menentukan informasi pemilik untuk pembantu yang terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile determinare le informazioni sul proprietario per l'helper installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされているヘルパーの所有者情報を特定できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 도우미의 소유자 정보를 확인할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke bekrefte eierinformasjonen til den installerte hjelperen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de eigenaarinformatie voor de geïnstalleerde helper niet bepalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można określić informacji o właścicielu dla zainstalowanego pomocnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar as informações do proprietário para o auxiliar instalado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar as informações do proprietário para o auxiliar instalado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposibil de determinat informațiile proprietarului pentru ajutorul instalat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно определить информацию о владельце для установленного помощника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att fastställa ägarinformation för installerad hjälpare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถระบุข้อมูลเจ้าของสำหรับตัวช่วยที่ติดตั้งไว้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü yardımcı için sahip bilgileri belirlenemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити інформацію про власника для встановленого помічника."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định thông tin chủ sở hữu cho người trợ giúp đã cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定已安装的助手的所有者信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定已安裝的協助程式的所有者資訊。"
          }
        }
      }
    },
