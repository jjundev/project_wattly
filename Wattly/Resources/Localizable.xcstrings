    "배터리 잔량이 목표치보다 높을 때 수동 방전 버튼을 표시합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض زر التفريغ اليدوي عندما يكون مستوى البطارية أعلى من المستوى المستهدف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje tlačítko ručního vybití, když je stav baterie nad cílovou úrovní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser knappen til manuel afladning, når batteriniveauet er over målniveauet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Schaltfläche zum manuellen Entladen an, wenn der Akkustand über dem Zielwert liegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει το κουμπί χειροκίνητης εκφόρτισης όταν η στάθμη της μπαταρίας είναι πάνω από το επίπεδο-στόχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the manual discharge button when the battery is above the target level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el botón de descarga manual cuando la batería está por encima del nivel objetivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää manuaalisen purkamisen painikkeen, kun akun varaustaso on tavoitetason yläpuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le bouton de décharge manuelle lorsque le niveau de batterie est supérieur à la cible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את כפתור הפריקה הידנית כאשר רמת הסוללה מעל לרמת היעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी का स्तर लक्ष्य से अधिक होने पर मैन्युअल डिस्चार्ज बटन प्रदर्शित करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjeleníti a kézi lemerítés gombot, ha az akkumulátor töltöttsége meghaladja a cél szintet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan tombol pengosongan manual saat daya baterai berada di atas target."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il pulsante di scarica manuale quando la batteria è al di sopra del livello target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が目標値より高いときに手動放電ボタンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 잔량이 목표치보다 높을 때 수동 방전 버튼을 표시합니다."
          }
        },
        "nb": {
