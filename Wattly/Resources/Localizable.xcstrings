    "Mac에 로그인하면 Wattly가 메뉴바에서 자동으로 시작됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인하면 Wattly가 메뉴바에서 자동으로 시작됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly starts automatically in the menu bar when you log in to your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macにログインすると、Wattlyがメニューバーで自動的に起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录Mac时，Wattly会在菜单栏中自动启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入Mac時，Wattly會在選單列中自動啟動。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly startet beim Anmelden an deinem Mac automatisch in der Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly démarre automatiquement dans la barre des menus lorsque vous ouvrez une session sur votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly se inicia automáticamente en la barra de menús al iniciar sesión en el Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly si avvia automaticamente nella barra dei menu quando accedi al Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wattly inicia automaticamente na barra de menus ao iniciar a sessão no seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wattly inicia automaticamente na barra de menus quando inicia a sessão no seu Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly start automatisch in de menubalk wanneer je inlogt op je Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly startar automatiskt i menyraden när du loggar in på din Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly starter automatisk i menulinjen, når du logger ind på din Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly käynnistyy automaattisesti valikkoriville, kun kirjaudut Maciin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly starter automatisk i menylinjen når du logger på Mac-en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly uruchamia się automatycznie na pasku menu po zalogowaniu na Macu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly se po přihlášení k Macu automaticky spustí v řádku nabídek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Wattly automatikusan elindul a menüsorban, amikor bejelentkezik a Macbe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly pornește automat în bara de meniuri când vă autentificați pe Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Wattly ξεκινά αυτόματα στη γραμμή μενού κατά τη σύνδεσή σας στο Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly автоматически запускается в строке меню при входе в систему Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly автоматично запускається на смузі меню під час входу в систему Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inize giriş yaptığınızda Wattly menü çubuğunda otomatik olarak başlar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ تشغيل Wattly تلقائيًا في شريط القوائم عند تسجيل الدخول إلى Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly מופעל אוטומטית בשורת התפריטים בעת התחברות ל-Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly จะเริ่มต้นทำงานโดยอัตโนมัติในแถบเมนูเมื่อคุณเข้าสู่ระบบ Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly sẽ tự động khởi chạy trên thanh menu khi bạn đăng nhập vào máy Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattly dimulai secara otomatis di bar menu saat Anda masuk ke Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप अपने Mac पर लॉगिन करते हैं, तो Wattly मेनू बार में स्वचालित रूप से प्रारंभ हो जाता है।"
          }
        }
      }
    },
