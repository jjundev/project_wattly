          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "24 fps sebességgel fut tétlen állapotban és 60 fps-sel aktív állapotban a rendkívül finom, magas képfrissítésű mozgásért."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează la 24 fps în repaus și 60 fps activ pentru o mișcare extrem de lină la rată mare de reîmprospătare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργεί στα 24 fps σε αδράνεια και 60 fps όταν είναι ενεργό, προσφέροντας εξαιρετικά ομαλή κίνηση υψηλού ρυθμού ανανέωσης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает с частотой 24 кадр/с в покое и 60 кадр/с при активности для максимально плавного движения с высокой частотой обновления."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює з частотою 24 кадр/с у стані спокою та 60 кадр/с при активності для надзвичайно плавного руху з високою частотою оновлення."
          }
