    "저장된 충전 정책을 읽지 못해 충전 허용 상태로 복구합니다": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 충전 정책을 읽지 못해 충전 허용 상태로 복구합니다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored charge policy could not be read; charging will be restored"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة سياسة الشحن المخزنة؛ ستتم استعادة الشحن"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze načíst uložené zásady nabíjení; nabíjení bude obnoveno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt opladningspolitik kunne ikke læses; opladning genoprettes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Laderichtlinie konnte nicht gelesen werden; Ladevorgang wird wiederhergestellt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση της αποθηκευμένης πολιτικής φόρτισης. Η φόρτιση θα αποκατασταθεί"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la política de carga guardada; se restaurará la carga"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettua latauskäytäntöä ei voitu lukea; lataus palautetaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la politique de charge enregistrée ; la charge va être rétablie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את מדיניות הטעינה השמורה; הטעינה תשוחזר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहीत चार्ज नीति नहीं पढ़ी जा सकी; चार्जिंग बहाल की जाएगी"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett töltési házirend nem olvasható; a töltés visszaállításra kerül"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan pengisian daya yang tersimpan tidak dapat dibaca; pengisian akan dipulihkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i criteri di carica memorizzati; la ricarica verrà ripristinata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された充電ポリシーを読み取れなかったため、充電許可状態に復帰します"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrede laderegler kunne ikke leses; lading vil bli gjenopprettet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen oplaadbeleid kon niet worden gelezen; opladen wordt hersteld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanych zasad ładowania; ładowanie zostanie przywrócone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de carga salva não pôde ser lida; o carregamento será restaurado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de carregamento guardada não pôde ser lida; o carregamento será restaurado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Politica de încărcare salvată nu a putut fi citită; încărcarea va fi restabilită"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сохраненную политику зарядки; зарядка будет восстановлена"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad laddningspolicy kunde inte läsas; laddning återställs"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านนโยบายการชาร์จที่บันทึกไว้ได้ จะกู้คืนสถานะอนุญาตให้ชาร์จ"
