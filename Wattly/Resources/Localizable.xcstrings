    "한 번만 완충 완료 (100% 유지 중, 어댑터 분리 시 원래 한도로 복귀)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top Up complete (Holding at 100%, normal limit restores on unplug)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 완충 완료 (100% 유지 중, 어댑터 분리 시 원래 한도로 복귀)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الشحن لمرة واحدة (الحفاظ على 100%، وتتم استعادة الحد الأصلي عند فصل المحول)"
