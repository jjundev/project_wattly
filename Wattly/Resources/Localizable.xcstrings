    "지정한 시각과 요일에 맞춰 충전 한도 변경 또는 100% 완충을 자동 실행합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغير حد الشحن أو ينفذ شحنًا بنسبة 100% تلقائيًا وفقًا للأوقات والأيام المحددة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky změní limit nabíjení nebo provede 100% dobití v zadaný čas a dny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer automatisk opladningsgrænse eller udfører 100 % fuld opladning på angivne tidspunkter og dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert das Ladelimit automatisch oder führt an festgelegten Tagen und Uhrzeiten eine 100%-Vollladung durch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει αυτόματα το όριο φόρτισης ή εκτελεί φόρτιση 100% στις καθορισμένες ώρες και ημέρες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically changes charge limit or performs 100% top-up at specified times and days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia automáticamente el límite de carga o realiza una recarga al 100% a las horas y días especificados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaa latausrajaa automaattisesti tai tekee 100 % täyteenlatauksen määritettyinä aikoina ja päivinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie automatiquement la limite de charge ou effectue une recharge à 100 % aux heures et jours spécifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משנה אוטומטית את מגבלת הטעינה או מבצע טעינה מלאה של 100% בזמנים ובימים שצוינו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्दिष्ट समय और दिनों पर चार्ज सीमा बदलता है या स्वचालित रूप से 100% पूर्ण चार्ज करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan módosítja a töltési korlátot vagy 100%-os töltést hajt végre a megadott időpontokban és napokon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis mengubah batas pengisian atau mengisi penuh hingga 100% pada waktu dan hari yang ditentukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica automaticamente il limite di carica o esegue una ricarica al 100% agli orari e nei giorni specificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した時刻と曜日に合わせて充電上限の変更や100%フル充電を自動実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 시각과 요일에 맞춰 충전 한도 변경 또는 100% 완충을 자동 실행합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endrer ladebegrensning automatisk eller utfører 100 % fullading til angitte tider og dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigt automatisch de oplaadlimiet of voert 100% opladen uit op opgegeven tijden en dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie zmienia limit ładowania lub wykonuje pełne naładowanie do 100% o wyznaczonych porach i dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera automaticamente o limite de carga ou realiza uma recarga a 100% nos horários e dias especificados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera automaticamente o limite de carregamento ou realiza um carregamento a 100% nas horas e dias especificados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă automat limita de încărcare sau efectuează o încărcare de 100% la orele și în zilele specificate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически изменяет лимит зарядки или заряжает до 100% в указанное время и дни недели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrar laddningsgränsen automatiskt eller utför en 100 % fulladdning vid angivna tider och dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนขีดจำกัดการชาร์จหรือชาร์จเต็ม 100% โดยอัตโนมัติตามเวลาและวันที่กำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirtilen saat ve günlerde şarj sınırını otomatik olarak değiştirir veya %100 tam şarj gerçekleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично змінює ліміт заряджання або виконує заряджання до 100% у призначений час і дні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động thay đổi giới hạn sạc hoặc thực hiện sạc đầy 100% vào thời gian và các ngày đã chỉ định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定的时间和星期自动更改充电限制或执行 100% 充满。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
