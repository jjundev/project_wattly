        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्जिंग शुरू नहीं होती। सिस्टम सेटिंग्स › बैटरी में 'अनुकूलित बैटरी चार्जिंग' बंद करें।"
