    "Energy Model 그룹을 읽을 수 없음 — 이 macOS에서 채널이 바뀌었을 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة مجموعة Energy Model — قد تكون القنوات قد تغيرت في إصدار macOS هذا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze načíst skupinu Energy Model — na této verzi macOS se mohly změnit kanály."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke læse Energy Model-gruppen — kanaler kan være ændret i denne macOS-version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Model-Gruppe kann nicht gelesen werden — Kanäle könnten sich auf dieser macOS-Version geändert haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αδυναμία ανάγνωσης ομάδας Energy Model — τα κανάλια ενδέχεται να έχουν αλλάξει σε αυτήν την έκδοση macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read Energy Model group — channels may have changed on this macOS version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el grupo Energy Model; es posible que los canales hayan cambiado en esta versión de macOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Model -ryhmää ei voi lukea — kanavat ovat saattaneet muuttua tässä macOS-versiossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le groupe Energy Model — les canaux ont peut-être changé sur cette version de macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את קבוצת Energy Model — ייתכן שהערוצים השתנו בגרסת macOS זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Model समूह को पढ़ने में असमर्थ — इस macOS संस्करण पर चैनल बदल गए होंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült kiolvasni az Energy Model csoportot — a csatornák megváltozhattak ezen a macOS verzión."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca grup Energy Model — saluran mungkin telah berubah pada versi macOS ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il gruppo Energy Model: i canali potrebbero essere cambiati in questa versione di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Modelグループを読み取れません — このmacOSでチャンネルが変更された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Model 그룹을 읽을 수 없음 — 이 macOS에서 채널이 바뀌었을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke lese Energy Model-gruppen — kanaler kan ha endret seg i denne macOS-versjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan Energy Model-groep niet lezen — kanalen zijn mogelijk gewijzigd op deze macOS-versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać grupy Energy Model — kanały mogły ulec zmianie w tej wersji systemu macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o grupo Energy Model — os canais podem ter mudado nesta versão do macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o grupo Energy Model — os canais podem ter mudado nesta versão do macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate citi grupul Energy Model — este posibil ca canalele să se fi schimbat în această versiune de macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать группу Energy Model — возможно, каналы изменились в этой версии macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte läsa Energy Model-gruppen — kanaler kan ha ändrats i denna macOS-version."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านกลุ่ม Energy Model — ช่องสัญญาณอาจมีการเปลี่ยนแปลงใน macOS เวอร์ชันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Model grubu okunamıyor — bu macOS sürümünde kanallar değişmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зчитати групу Energy Model — можливо, канали змінилися в цій версії macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc nhóm Energy Model — các kênh có thể đã thay đổi trên phiên bản macOS này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 Energy Model 组 — 在此 macOS 版本上传输通道可能已更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 Energy Model 群組 — 在此 macOS 版本上通道可能已變更。"
          }
        }
      }
    },
