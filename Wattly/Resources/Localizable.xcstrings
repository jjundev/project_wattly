    "모든 Wattly 설정을 기본값으로 되돌릴까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Wattly 설정을 기본값으로 되돌릴까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all Wattly settings to defaults?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのWattly設定をデフォルトに戻しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将所有Wattly设置恢复为默认值吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將所有Wattly設定回復為預設值嗎？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Wattly-Einstellungen auf Standardwerte zurücksetzen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir tous les réglages de Wattly par défaut ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer todos los ajustes de Wattly a los valores predeterminados?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare tutte le impostazioni di Wattly ai valori predefiniti?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir todos os ajustes do Wattly para os padrões?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor todas as definições do Wattly para as predefinições?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Wattly-instellingen herstellen naar standaardwaarden?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du återställa alla Wattly-inställningar till standardvärden?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du gendanne alle Wattly-indstillinger til standard?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko palauttaa kaikki Wattlyn asetukset oletusarvoihin?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du tilbakestille alle Wattly-innstillinger til standard?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy zresetować wszystkie ustawienia Wattly do wartości domyślnych?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete obnovit všechna nastavení Wattly na výchozí hodnoty?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítja a Wattly összes beállítását az alapértékekre?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restabiliți toate configurările Wattly la valorile implicite?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά όλων των ρυθμίσεων του Wattly στις προεπιλογές;"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить все настройки Wattly по умолчанию?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути всі параметри Wattly до стандартних?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Wattly ayarları varsayılanlara sıfırlansın mı?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إعادة تعيين جميع إعدادات Wattly إلى الإعدادات الافتراضية؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשחזר את כל הגדרות Wattly לברירות המחדל?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าการตั้งค่า Wattly ทั้งหมดเป็นค่าเริ่มต้นหรือไม่?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại tất cả cài đặt của Wattly về mặc định?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur ulang semua pengaturan Wattly ke default?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या सभी Wattly सेटिंग्स को डिफ़ॉल्ट पर रीसेट करें?"
          }
        }
      }
    },
    "카드 표시, 메뉴바, 경고 기준, 팬 커브 및 자동 실행 설정이 초기화됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 표시, 메뉴바, 경고 기준, 팬 커브 및 자동 실행 설정이 초기화됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card visibility, menu bar, threshold alerts, fan curve, and auto-launch settings will be reset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードの表示、メニューバー、警告のしきい値、ファンカーブ、および自動起動の設定がリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片显示、菜单栏、告警阈值、风扇曲线和自动启动设置将被重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片顯示、選單列、警示臨界值、風扇曲線及自動啟動設定將會重設。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartensichtbarkeit, Menüleiste, Schwellenwert-Warnungen, Lüfterkurve und Autostart-Einstellungen werden zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilité des cartes, la barre des menus, les alertes de seuil, la courbe des ventilateurs et l'ouverture automatique seront réinitialisés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecerán la visibilidad de las tarjetas, la barra de menús, las alertas de umbral, la curva de ventiladores y el inicio automático."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilità delle schede, la barra dei menu, gli avvisi di soglia, la curva della ventola e l'avvio automatico verranno ripristinati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visibilidade dos cartões, a barra de menus, os alertas de limite, a curva de ventoinhas e o início automático serão redefinidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A visibilidade dos cartões, a barra de menus, os alertas de limite, a curva da ventoinha e o arranque automático serão repostos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaartweergave, menubalk, drempelwaarschuwingen, ventilatorcurve en instellingen voor automatisch opstarten worden gereset."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortvisning, menyrad, tröskelvarningar, fläktkurva och autostartinställningar återställs."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortsynlighed, menulinje, grænseadvarsler, blæserkurve og autostartindstillinger nulstilles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korttien näkyvyys, valikkorivi, kynnyshälytykset, tuuletinkäyrä ja automaattikäynnistyksen asetukset nollataan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortvisning, menylinje, terskelvarsler, viftekurve og autostartinnstillinger tilbakestilles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczność kart, pasek menu, alerty progowe, krzywa wentylatorów oraz autostart zostaną zresetowane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditelnost karet, řádek nabídek, prahová upozornění, křivka ventilátorů a automatické spouštění budou obnoveny na výchozí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyák láthatósága, a menüsor, a küszöbérték-értesítések, a ventilátorgörbe és az automatikus indítás beállításai visszaállnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizibilitatea cardurilor, bara de meniuri, alertele de prag, curba ventilatoarelor și lansarea automată vor fi resetate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ορατότητα καρτών, η γραμμή μενού, οι ειδοποιήσεις ορίων, η καμπύλη ανεμιστήρα και η αυτόματη έναρξη θα επανέλθουν στις αρχικές ρυθμίσεις."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображение карточек, строка меню, пороговые оповещения, кривая вентилятора и автозапуск будут сброшены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображення карток, смуга меню, порогові сповіщення, крива вентилятора та автозапуск буде скинуто."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart görünürlüğü, menü çubuğu, eşik uyarıları, fan eğrisi ve otomatik başlatma ayarları sıfırlanacaktır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة تعيين رؤية البطاقات وشريط القوائم وتنبيهات العتبة ومنحنى المروحة وإعدادات التشغيل التلقائي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות תצוגת הכרטיסים, שורת התפריטים, התראות הסף, עקומת המאוורר וההפעלה האוטומטית יאופסו."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การมองเห็นการ์ด แถบเมนู การเตือนตามเกณฑ์ เส้นโค้งพัดลม และการตั้งค่าเปิดใช้อัตโนมัติจะถูกรีเซ็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khả năng hiển thị thẻ, thanh menu, cảnh báo ngưỡng, đường cong quạt và cài đặt tự động khởi chạy sẽ được đặt lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilitas kartu, bar menu, peringatan ambang batas, kurva kipas, dan pengaturan peluncuran otomatis akan diatur ulang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड दृश्यता, मेनू बार, सीमा अलर्ट, फ़ैन कर्व और ऑटो-लॉन्च सेटिंग्स रीसेट हो जाएंगी।"
          }
        }
      }
    },
    "취소": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
