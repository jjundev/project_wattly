    "선택한 부하가 높을수록 메뉴바 아이콘의 움직임 속도가 빨라집니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 부하가 높을수록 메뉴바 아이콘의 움직임 속도가 빨라집니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar icon animates faster as the selected workload increases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した負荷が高くなるほど、メニューバーアイコンの動作速度が速くなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选定的负载越高，菜单栏图标的动画速度越快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取的負載越高，選單列圖示的動畫速度越快。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Menüleistensymbol bewegt sich schneller, je höher die ausgewählte Auslastung ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône de la barre des menus s'anime plus rapidement lorsque la charge sélectionnée augmente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la barra de menús se anima más rápido a medida que aumenta la carga seleccionada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona della barra dei menu si anima più velocemente all'aumentare del carico selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da barra de menus anima mais rápido conforme a carga selecionada aumenta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da barra de menus anima mais depressa à medida que a carga selecionada aumenta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het menubalksymbool animeert sneller naarmate de geselecteerde belasting toeneemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyradsikonen animeras snabbare när den valda belastningen ökar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulinjeikonet animeres hurtigere, når den valgte belastning stiger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikkorivin kuvake liikkuu nopeammin, kun valittu kuormitus kasvaa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Menylinjeikonet animeres raskere etter hvert som den valgte belastningen øker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona na pasku menu animuje się szybciej wraz ze wzrostem wybranego obciążenia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona v řádku nabídek se animuje rychleji při zvýšení vybraného zatížení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A menüsor ikonja gyorsabban animálódik a kiválasztott terhelés növekedésével."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictograma din bara de meniuri se animează mai rapid pe măsură ce sarcina selectată crește."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το εικονίδιο της γραμμής μενού κινείται ταχύτερα καθώς αυξάνεται το επιλεγμένο φορτίο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок в строке меню анимируется быстрее по мере роста выбранной нагрузки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок на смузі меню анімується швидше зі збільшенням вибраного навантаження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen iş yükü arttıkça menü çubuğu simgesi daha hızlı hareket eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك أيقونة شريط القوائم بشكل أسرع مع زيادة عبء العمل المحدد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמל שורת התפריטים מונפש מהר יותר ככל שעומס העבודה שנבחר גדל."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนแถบเมนูจะเคลื่อนไหวเร็วขึ้นเมื่อปริมาณงานที่เลือกเพิ่มขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng trên thanh menu chuyển động nhanh hơn khi tải công việc đã chọn tăng lên."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon bar menu beranimasi lebih cepat seiring bertambahnya beban kerja yang dipilih."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित वर्कलोड बढ़ने पर मेनू बार आइकन तेज़ी से एनिमेट होता है।"
          }
        }
      }
    },
    "선택한 부하를 읽는 동안 아이콘은 정지합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 부하를 읽는 동안 아이콘은 정지합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon stays paused while reading selected workload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した負荷の読み込み中、アイコンは停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取选定负载期间，图标保持静止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取所選負載期間，圖示保持靜止。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol pausiert beim Auslesen der ausgewählten Last."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône reste en pause pendant la lecture de la charge sélectionnée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono permanece en pausa mientras lee la carga seleccionada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona rimane in pausa durante la lettura del carico selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone permanece pausado durante a leitura da carga selecionada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone permanece em pausa durante a leitura da carga selecionada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbool blijft gepauzeerd tijdens het uitlezen van de geselecteerde belasting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonen pausas medan den valda belastningen läses in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet er sat på pause, mens den valgte belastning indlæses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvake pysyy pysäytettynä valitun kuormituksen lukemisen aikana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet pauses mens den valgte belastningen leses av."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona jest wstrzymana podczas odczytywania wybranego obciążenia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během načítání vybraného zatížení je ikona pozastavena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ikon szünetel a kiválasztott terhelés olvasása közben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictograma rămâne întreruptă în timpul citirii sarcinii selectate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το εικονίδιο παραμένει σε παύση κατά την ανάγνωση του επιλεγμένου φορτίου."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок приостановлен во время считывания выбранной нагрузки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок призупинено під час зчитування вибраного навантаження."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen iş yükü okunurken simge duraklatılır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الأيقونة متوقفة مؤقتًا أثناء قراءة عبء العمل المحدد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסמל מושהה בזמן קריאת עומס העבודה שנבחר."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนจะหยุดชั่วคราวขณะอ่านปริมาณงานที่เลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng tạm dừng trong khi đọc tải công việc đã chọn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon dijeda saat membaca beban kerja yang dipilih."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित वर्कलोड पढ़ते समय आइकन रुका रहता है।"
          }
        }
      }
    },
