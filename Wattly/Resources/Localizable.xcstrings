    "외출 전에 한 번만 100%까지 완충하며, 어댑터를 분리하면 기존 한도로 자동 복귀합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges to 100% once before heading out, then automatically restores your charge limit when unplugged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외출 전에 한 번만 100%까지 완충하며, 어댑터를 분리하면 기존 한도로 자동 복귀합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شحن لمرة واحدة حتى 100% قبل الخروج، وتتم استعادة الحد الأصلي تلقائيًا عند فصل المحول."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorázově nabije na 100 % před odchodem a po odpojení adaptéru automaticky obnoví původní limit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplader til 100 % én gang før afgang og vender automatisk tilbage til den oprindelige grænse ved frakobling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliges Laden auf 100% vor dem Ausgehen; stellt das ursprüngliche Limit beim Trennen automatisch wieder her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτίζει στο 100% μία φορά πριν την έξοδο και επανέρχεται αυτόματα στο αρχικό όριο κατά την αποσύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga al 100% una sola vez antes de salir y restaura automáticamente el límite original al desconectar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa kerran 100 %:iin ennen lähtöä ja palauttaa alkuperäisen rajan automaattisesti, kun virtalähde irrotetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge à 100 % une seule fois avant le départ et rétablit automatiquement la limite d'origine au débranchement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוען ל-100% פעם אחת לפני יציאה, ומשחזר אוטומטית את המגבלה המקורית בעת ניתוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहर जाने से पहले एक बार 100% तक चार्ज करता है, फिर अनप्लग करने पर सामान्य सीमा बहाल करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indulás előtt egyszer 100%-ra tölt, majd leválasztáskor automatikusan visszaáll az eredeti korlát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisi hingga 100% satu kali sebelum bepergian, lalu otomatis mengembalikan batas awal saat adaptor dicabut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica al 100% una sola volta prima di uscire, quindi ripristina automaticamente il limite originale allo scollegamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出前に1回だけ100%までフル充電し、アダプタを抜くと元の制限に自動復帰します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader til 100 % én gang før du drar, og går automatisk tilbake til opprinnelig grense ved frakobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt eenmalig op tot 100% voor vertrek en herstelt automatisch naar de oorspronkelijke limiet na loskoppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładuje jednorazowo do 100% przed wyjściem i automatycznie przywraca pierwotny limit po odłączeniu zasilacza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega a 100% uma única vez antes de sair e restaura automaticamente o limite original ao desconectar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega a 100% uma única vez antes de sair e restaura automaticamente o limite original ao desligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă la 100% o singură dată înainte de plecare și revine automat la limita inițială la deconectare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Однократно заряжает до 100% перед выходом и автоматически возвращается к исходному лимиту при отключении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar till 100 % en gång före avfärd och återgår automatiskt till ursprunglig gräns vid urkoppling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชาร์จเต็ม 100% หนึ่งครั้งก่อนออกไปข้างนอก และจะกลับสู่ขีดจำกัดเดิมโดยอัตโนมัติเมื่อถอดสายชาร์จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışarı çıkmadan önce bir kereliğine %100'e kadar doldurur ve adaptör çıkarıldığında orijinal sınıra otomatik döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразово заряджає до 100% перед виходом і автоматично відновлює початковий ліміт після від'єднання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sạc đầy đến 100% một lần trước khi ra ngoài và tự động khôi phục giới hạn ban đầu khi rút sạc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出门前一次性充满至 100%，并在断开电源适配器后自动恢复原有充电限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出門前一次性充滿至 100%，並在拔掉電源轉接器後自動恢復原有充電限制。"
          }
        }
      }
    },
