    "패널 상태와 관계없이 활성 지표를 1초마다 갱신합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 상태와 관계없이 활성 지표를 1초마다 갱신합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates active metrics every 1 second regardless of panel state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの状態に関係なく、アクティブな指標を1秒ごとに更新します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论面板状态如何，每隔1秒刷新一次活动指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論面板狀態為何，每隔1秒重新整理一次使用中的指標。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiert aktive Messwerte unabhängig vom Panel-Status jede Sekunde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualise les mesures actives toutes les secondes, quel que soit l'état du panneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza las métricas activas cada 1 segundo independientemente del estado del panel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna le metriche attive ogni secondo, indipendentemente dallo stato del pannello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza as métricas ativas a cada 1 segundo, independentemente do estado do painel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza as métricas ativas a cada 1 segundo, independentemente do estado do painel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt actieve statistieken elke seconde bij, ongeacht de paneelstatus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdaterar aktiva mätvärden varje sekund oavsett panelens tillstånd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdaterer aktive målinger hvert sekund uanset panelets tilstand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittää aktiiviset mittarit 1 sekunnin välein paneelin tilasta riippumatta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdaterer aktive målinger hvert sekund uavhengig av panelets tilstand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeża aktywne wskaźniki co 1 sekundę, niezależnie od stanu panelu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje aktivní metriky každou sekundu bez ohledu na stav panelu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel állapotától függetlenül másodpercenként frissíti az aktív mérőszámokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează valorile active la fiecare secundă, indiferent de starea panoului."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώνει τις ενεργές μετρήσεις κάθε 1 δευτερόλεπτο, ανεξάρτητα από την κατάσταση του πίνακα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляет активные показатели каждую секунду независимо от состояния панели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлює активні показники щосекунди незалежно від стану панелі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel durumundan bağımsız olarak etkin metrikleri her 1 saniyede bir günceller."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّث المقاييس النشطة كل ثانية واحدة بغض النظر عن حالة اللوحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעדכן מדדים פעילים כל שנייה אחת ללא קשר למצב החלונית."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตตัวชี้วัดที่ใช้งานอยู่ทุก 1 วินาที โดยไม่คำนึงถึงสถานะของแผงควบคุม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật các chỉ số đang hoạt động mỗi 1 giây bất kể trạng thái của bảng điều khiển."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui metrik aktif setiap 1 detik terlepas dari status panel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैनल की स्थिति की परवाह किए बिना हर 1 सेकंड में सक्रिय मेट्रिक्स को अपडेट करता है।"
          }
        }
      }
    },
