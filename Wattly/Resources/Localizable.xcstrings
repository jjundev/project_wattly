    "로그인 시 자동 실행 해제를 완료하지 못해 Wattly 삭제를 중단했습니다: %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إلغاء التسجيل من الفتح عند تسجيل الدخول، تم إيقاف إزالة Wattly: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se zrušit automatické spuštění při přihlášení, odinstalace Wattly byla zrušena: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke fjerne åbning ved login, afinstallation af Wattly stoppet: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autostart bei Anmeldung konnte nicht deaktiviert werden, Wattly-Deinstallation abgebrochen: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ακύρωση του ανοίγματος κατά τη σύνδεση, η απεγκατάσταση του Wattly διακόπηκε: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not unregister launch at login, uninstallation aborted: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar el inicio al iniciar sesión, desinstalación de Wattly cancelada: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistyksen poistaminen sisäänkirjauduttaessa epäonnistui, Wattlyn asennuksen poisto keskeytetty: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver l'ouverture à la connexion, suppression de Wattly interrompue : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבטל את ההפעלה בעת התחברות, הסרת Wattly הופסקה: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन पर ऑटो-लॉन्च को अनरजिस्टर नहीं किया जा सका, Wattly अनइंस्टॉलेशन रुका: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megszüntetni a bejelentkezéskori indítást, a Wattly eltávolítása megszakadt: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membatalkan mulai otomatis saat masuk, pencopotan Wattly dihentikan: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile annullare l'apertura al login, rimozione di Wattly interrotta: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時自動起動の解除が完了しなかったため、Wattlyの削除を中止しました: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 자동 실행 해제를 완료하지 못해 Wattly 삭제를 중단했습니다: %@"
