          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرتب المقاييس في شبكة مدمجة من عمودين للحصول على نظرة عامة سريعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסדר את המדדים ברשת קומפקטית של 2 עמודות לסקירה מהירה."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเรียงตัวชี้วัดในตาราง 2 คอลัมน์ขนาดกะทัดรัดเพื่อให้ดูภาพรวมได้อย่างรวดเร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các chỉ số trong lưới 2 cột nhỏ gọn để xem tổng quan nhanh chóng."
          }
        },
        "id": {
