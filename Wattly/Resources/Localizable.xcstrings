    "충전 제한을 켜면 한도를 조절할 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 제한을 켜면 한도를 조절할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the charge limit to adjust the maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電上限をオンにすると上限を調整できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开充电上限后即可调整最大值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟充電上限後即可調整最大值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere das Ladelimit, um das Maximum anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la limite de charge pour ajuster le maximum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el límite de carga para ajustar el máximo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il limite di carica per regolare il massimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o limite de carga para ajustar o máximo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o limite de carga para ajustar o máximo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de laadlimiet in om het maximum aan te passen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera laddningsgränsen för att justera maxvärdet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå opladningsgrænsen til for at justere maksimum."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota latausraja käyttöön säätääksesi enimmäisarvoa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på ladegrensen for å justere maksimumsverdien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz limit ładowania, aby dostosować wartość maksymalną."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte limit nabíjení, chcete-li upravit maximum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a töltési korlátot a maximum módosításához."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează limita de încărcare pentru a ajusta maximul."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το όριο φόρτισης για να προσαρμόσετε το μέγιστο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите лимит зарядки, чтобы настроить максимум."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть ліміт заряджання, щоб налаштувати максимум."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum değeri ayarlamak için şarj sınırını açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعِّل حد الشحن لضبط الحد الأقصى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל את מגבלת הטעינה כדי לכוונן את הערך המרבי."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดขีดจำกัดการชาร์จเพื่อปรับค่าสูงสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật giới hạn sạc để điều chỉnh mức tối đa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan batas pengisian daya untuk menyesuaikan nilai maksimum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम मान समायोजित करने के लिए चार्ज सीमा चालू करें।"
          }
        }
      }
    },
