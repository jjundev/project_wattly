    "발열 보호가 작동 중입니다. 배터리가 식은 뒤에 시작해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat protection is active. Start once the battery has cooled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hitzeschutz ist aktiv. Starte, sobald der Akku abgekühlt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発熱保護が作動中です。バッテリーが冷えてから開始してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection thermique est active. Démarrez une fois la batterie refroidie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección contra calor está activa. Comienza cuando la batería se haya enfriado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione termica è attiva. Avvia dopo che la batteria si è raffreddata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção térmica está ativa. Inicie após a bateria esfriar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção térmica está ativa. Inicie assim que a bateria arrefecer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hittebescherming is actief. Start zodra de batterij is afgekoeld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överhettningsskyddet är aktivt. Starta när batteriet har svalnat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmebeskyttelsen er aktiv. Start, når batteriet er kølet af."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämpösuojaus on aktiivinen. Aloita, kun akku on jäähtynyt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmebeskyttelsen er aktiv. Start når batteriet har kjølt seg ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona przed przegrzaniem jest aktywna. Rozpocznij po ostygnięciu baterii."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepelná ochrana je aktivní. Spusťte po vychladnutí baterie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hővédelem aktív. Indítsd el, miután az akkumulátor lehűlt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecția termică este activă. Începe după ce bateria se răcește."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προστασία υπερθέρμανσης είναι ενεργή. Ξεκινήστε αφού κρυώσει η μπαταρία."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активна защита от перегрева. Начните после охлаждения батареи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний захист від перегріву. Почніть після охолодження акумулятора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isı koruması etkin. Pil soğuduktan sonra başlatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحماية من الحرارة نشطة. ابدأ بعد أن تبرد البطارية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגנת התחממות פעילה. התחל לאחר שהסוללה תתקרר."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบป้องกันความร้อนทำงานอยู่ โปรดเริ่มหลังจากแบตเตอรี่เย็นลงแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo vệ quá nhiệt đang hoạt động. Hãy bắt đầu sau khi pin đã nguội."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlindungan panas aktif. Mulai setelah baterai mendingin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताप सुरक्षा सक्रिय है। बैटरी ठंडी होने के बाद शुरू करें।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过热保护正在运行，请等电池降温后再开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過熱保護正在運作，請等電池降溫後再開始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발열 보호가 작동 중입니다. 배터리가 식은 뒤에 시작해 주세요."
          }
        }
      }
    },
