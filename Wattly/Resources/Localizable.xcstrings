    "Wattly 및 모든 데이터를 완전히 삭제할까요?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ترغب في إلغاء تثبيت Wattly وحذف جميع البيانات؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete odinstalovat Wattly a smazat všechna data?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du afinstallere Wattly og slette alle data?"
          }
