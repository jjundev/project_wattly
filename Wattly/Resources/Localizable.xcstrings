    "CPU 코어 클럭(GHz)에 비례하여 움직입니다. 연산 작업 시작 시 즉각적인 반응을 보여줍니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 코어 클럭(GHz)에 비례하여 움직입니다. 연산 작업 시작 시 즉각적인 반응을 보여줍니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animates proportionally to CPU clock (GHz). Reacts immediately when compute tasks start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUコアクロック（GHz）に比例して動作します。計算処理の開始時に即座に反応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与CPU核心时钟频率（GHz）成比例动态变化。在计算任务开始时能立即响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與CPU核心時脈（GHz）成比例動態變化。在運算工作開始時能立即反應。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiert proportional zum CPU-Kerntakt (GHz). Reagiert sofort beim Start von Rechenaufgaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'anime proportionnellement à la fréquence des cœurs CPU (GHz). Réagit immédiatement au lancement de calculs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anima proporcionalmente a la frecuencia del núcleo de la CPU (GHz). Reacciona de inmediato al iniciar tareas de cálculo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si anima proporzionalmente alla frequenza dei core CPU (GHz). Reagisce immediatamente all'avvio dei carichi di calcolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente ao clock dos núcleos da CPU (GHz). Reage imediatamente ao iniciar tarefas de processamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente à frequência dos núcleos da CPU (GHz). Reage imediatamente quando tarefas de computação são iniciadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeert evenredig met de CPU-kloksnelheid (GHz). Reageert direct wanneer rekentaken starten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeras proportionellt mot CPU-klockfrekvensen (GHz). Reagerar omedelbart när beräkningsuppgifter startar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proportionalt med CPU-frekvensen (GHz). Reagerer øjeblikkeligt, når beregningsopgaver starter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkuu suhteessa CPU:n kellotaajuuteen (GHz). Reagoi välittömästi laskentatehtävien alkaessa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proporsjonalt med CPU-klokkehastigheten (GHz). Reagerer umiddelbart når beregningsoppgaver starter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje się proporcjonalnie do taktowania rdzeni CPU (GHz). Natychmiast reaguje na rozpoczęcie obliczeń."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje se úměrně k frekvenci jader CPU (GHz). Okamžitě reaguje při spuštění výpočetních úloh."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CPU magok órajelével (GHz) arányosan animálódik. Azonnal reagál a számítási feladatok indításakor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se animează proporțional cu frecvența nucleelor CPU (GHz). Reacționează imediat la pornirea activităților de calcul."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κινείται αναλογικά με τον χρονισμό των πυρήνων CPU (GHz). Αντιδρά άμεσα κατά την έναρξη υπολογιστικών εργασιών."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимируется пропорционально тактовой частоте ядер CPU (ГГц). Мгновенно реагирует на начало вычислений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімується пропорційно тактовій частоті ядер CPU (ГГц). Миттєво реагує на початок обчислювальних завдань."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU saatine (GHz) orantılı olarak hareket eder. Hesaplama görevleri başladığında anında tepki verir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك بشكل متناسب مع تردد CPU (بالجيجاهرتز). يستجيب على الفور عند بدء مهام الحوسبة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונפש ביחס לתדר ה-CPU (ב-GHz). מגיב באופן מיידי בעת תחילת פעולות חישוב."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวตามสัดส่วนของสัญญาณนาฬิกา CPU (GHz) ตอบสนองทันทีเมื่องานประมวลผลเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển động tỷ lệ thuận với xung nhịp CPU (GHz). Phản hồi ngay lập tức khi các tác vụ tính toán bắt đầu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beranimasi secara proporsional dengan clock CPU (GHz). Bereaksi seketika saat tugas komputasi dimulai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU क्लॉक (GHz) के अनुपात में एनिमेट होता है। गणना कार्य शुरू होने पर तुरंत प्रतिक्रिया देता है।"
          }
        }
      }
    },
    "SoC 전체 전력 소비량(W)에 비례하여 움직입니다. 시스템의 실제 작업 부하를 가장 정확하게 반영합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SoC 전체 전력 소비량(W)에 비례하여 움직입니다. 시스템의 실제 작업 부하를 가장 정확하게 반영합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animates proportionally to total SoC power (W). Most accurately reflects true system workload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SoC全体の消費電力（W）に比例して動作します。システムの実際のワークロードを最も正確に反映します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与SoC总功耗（W）成比例动态变化。能最准确地反映系统的实际工作负载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與SoC總功耗（W）成比例動態變化。能最準確地反映系統的實際工作負載。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiert proportional zum gesamten SoC-Stromverbrauch (W). Spiegelt die tatsächliche Systemlast am genauesten wider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'anime proportionnellement à la puissance totale du SoC (W). Reflète fidèlement la charge de travail réelle du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anima proporcionalmente a la potencia total del SoC (W). Refleja con mayor precisión la carga de trabajo real del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si anima proporzionalmente al consumo energetico totale del SoC (W). Riflette con la massima precisione il carico effettivo del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente ao consumo total do SoC (W). Reflete com mais precisão a verdadeira carga de trabalho do sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente ao consumo total do SoC (W). Reflete com maior precisão a carga real do sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeert evenredig met het totale SoC-stroomverbruik (W). Geeft de werkelijke systeembelasting het meest nauwkeurig weer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeras proportionellt mot SoC:ns totala strömförbrukning (W). Återspeglar systemets faktiska arbetsbelastning mest exakt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proportionalt med SoC'ens samlede strømforbrug (W). Afspejler systemets reelle arbejdsbelastning mest præcist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkuu suhteessa järjestelmäpiirin (SoC) kokonaisvirrankulutukseen (W). Heijastaa järjestelmän todellista kuormitusta tarkimmin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proporsjonalt med SoC-ens totale strømforbruk (W). Gjenspeiler systemets faktiske arbeidsbelastning mest nøyaktig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje się proporcjonalnie do całkowitego poboru mocy układu SoC (W). Najdokładniej odzwierciedla rzeczywiste obciążenie systemu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje se úměrně k celkové spotřebě SoC (W). Nejpřesněji odráží skutečné pracovní zatížení systému."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes SoC energiafogyasztásával (W) arányosan animálódik. A legpontosabban tükrözi a rendszer valós terhelését."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se animează proporțional cu consumul total de energie SoC (W). Reflectă cel mai precis volumul real de lucru al sistemului."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κινείται αναλογικά με τη συνολική κατανάλωση ισχύος του SoC (W). Αντικατοπτρίζει με τη μεγαλύτερη ακρίβεια τον πραγματικό φόρτο εργασίας του συστήματος."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимируется пропорционально общему энергопотреблению SoC (Вт). Наиболее точно отражает реальную рабочую нагрузку системы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімується пропорційно загальному споживанню енергії SoC (Вт). Найточніше відображає реальне робоче навантаження системи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam SoC güç tüketimiyle (W) orantılı olarak hareket eder. Gerçek sistem iş yükünü en doğru şekilde yansıtır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك بما يتناسب مع إجمالي طاقة SoC (بالواط). يعكس بدقة أعلى عبء العمل الحقيقي للنظام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונפש ביחס לצריכת החשמל הכוללת של ה-SoC (ב-W). משקף בצורה המדויקת ביותר את עומס המערכת בפועל."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวตามสัดส่วนการใช้พลังงาน SoC ทั้งหมด (W) สะท้อนภาระงานจริงของระบบได้อย่างแม่นยำที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển động tỷ lệ thuận với tổng mức tiêu thụ điện của SoC (W). Phản ánh chính xác nhất tải công việc thực tế của hệ thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beranimasi secara proporsional dengan total daya SoC (W). Mencerminkan beban kerja sistem yang sebenarnya secara paling akurat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुल SoC बिजली खपत (W) के अनुपात में एनिमेट होता है। वास्तविक सिस्टम वर्कलोड को सबसे सटीक रूप से दर्शाता है।"
          }
        }
      }
    },
    "CPU와 GPU의 평균 점유율(%)에 비례하여 움직입니다. 기존의 사용률 기준 동작을 선호할 때 적합합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU와 GPU의 평균 점유율(%)에 비례하여 움직입니다. 기존의 사용률 기준 동작을 선호할 때 적합합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animates proportionally to average CPU & GPU usage (%). Best for traditional utilization-based motion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUとGPUの平均使用率（%）に比例して動作します。従来の利用率に基づいた動作を好む場合に適しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与CPU和GPU的平均占用率（%）成比例动态变化。适合偏好传统使用率基准的用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與CPU和GPU的平均佔用率（%）成比例動態變化。適合偏好傳統使用率基準的使用者。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiert proportional zur durchschnittlichen CPU- und GPU-Auslastung (%). Ideal für herkömmliche auslastungsbasierte Bewegungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'anime proportionnellement à l'utilisation moyenne du CPU et du GPU (%). Idéal pour un comportement classique basé sur le taux d'utilisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anima proporcionalmente al uso promedio de CPU y GPU (%). Ideal si prefieres el comportamiento tradicional basado en el uso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si anima proporzionalmente all'utilizzo medio di CPU e GPU (%). Ideale per chi preferisce un movimento basato sull'utilizzo tradizionale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente ao uso médio de CPU e GPU (%). Ideal para o comportamento tradicional baseado em porcentagem de uso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima proporcionalmente à utilização média de CPU e GPU (%). Ideal para quem prefere o comportamento tradicional baseado na utilização."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeert evenredig met het gemiddelde CPU- en GPU-gebruik (%). Ideaal voor traditionele beweging op basis van belasting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeras proportionellt mot genomsnittlig CPU- och GPU-användning (%). Lämpligt om du föredrar traditionell användningsbaserad rörelse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proportionalt med gennemsnitlig CPU- og GPU-belastning (%). Velegnet til traditionel udnyttelsesbaseret bevægelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkuu suhteessa CPU:n ja GPU:n keskimääräiseen käyttöasteeseen (%). Sopii perinteistä käyttöasteeseen perustuvaa liikettä suosiville."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeres proporsjonalt med gjennomsnittlig CPU- og GPU-bruk (%). Passer for de som foretrekker tradisjonell utnyttelsesbasert bevegelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje się proporcjonalnie do średniego użycia CPU i GPU (%). Odpowiednie dla osób preferujących tradycyjny ruch oparty na obciążeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuje se úměrně k průměrnému využití CPU a GPU (%). Vhodné, pokud preferujete tradiční pohyb založený na využití."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átlagos CPU és GPU kihasználtsággal (%) arányosan animálódik. Ideális, ha a hagyományos kihasználtság-alapú mozgást részesíti előnyben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se animează proporțional cu utilizarea medie CPU și GPU (%). Potrivit dacă preferați mișcarea tradițională bazată pe utilizare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κινείται αναλογικά με τη μέση χρήση CPU και GPU (%). Κατάλληλο για όσους προτιμούν την παραδοσιακή κίνηση βάσει ποσοστού χρήσης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимируется пропорционально среднему уровню использования CPU и GPU (%). Подходит для привычного отображения на основе процента загрузки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімується пропорційно середньому рівню використання CPU та GPU (%). Підходить, якщо ви віддаєте перевагу традиційній поведінці на основі відсотка використання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortalama CPU ve GPU kullanımına (%) orantılı olarak hareket eder. Geleneksel kullanım tabanlı hareketi tercih edenler için uygundur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك بما يتناسب مع متوسط استخدام CPU وGPU (٪). مناسب لمن يفضل الحركة التقليدية القائمة على نسبة الاستخدام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונפש ביחס לממוצע השימוש ב-CPU וב-GPU (ב-%). מתאים למי שמעדיף תנועה מסורתית מבוססת שימוש."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลื่อนไหวตามสัดส่วนการใช้งานเฉลี่ยของ CPU และ GPU (%) เหมาะสำหรับผู้ที่ต้องการการเคลื่อนไหวตามอัตราการใช้งานแบบเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển động tỷ lệ thuận với mức sử dụng trung bình của CPU và GPU (%). Phù hợp khi ưu tiên chuyển động dựa trên mức sử dụng truyền thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beranimasi secara proporsional dengan rata-rata penggunaan CPU & GPU (%). Paling cocok untuk animasi berbasis penggunaan tradisional."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "औसत CPU और GPU उपयोग (%) के अनुपात में एनिमेट होता है। पारंपरिक उपयोग-आधारित गति के लिए सबसे उपयुक्त।"
          }
        }
      }
    },
