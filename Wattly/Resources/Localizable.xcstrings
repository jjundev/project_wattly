    "이 Mac은 충전 제어를 지원하지 않습니다. 이 기능이 사용하는 SMC 레지스터가 없습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 충전 제어를 지원하지 않습니다. 이 기능이 사용하는 SMC 레지스터가 없습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac does not support charge control. It lacks the SMC register this feature uses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは充電制御に対応していません。この機能が使用するSMCレジスタがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不支持充电控制。它没有此功能所使用的 SMC 寄存器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不支援充電控制。它沒有此功能所使用的 SMC 暫存器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt keine Ladesteuerung. Ihm fehlt das für diese Funktion verwendete SMC-Register."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge le contrôle de charge. Il ne dispose pas du registre SMC utilisé par cette fonctionnalité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no admite el control de carga. Carece del registro SMC que usa esta función."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non supporta il controllo della carica. Manca il registro SMC utilizzato da questa funzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não é compatível com o controle de carga. Ele não possui o registro SMC usado por este recurso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não é compatível com o controlo de carga. Não possui o registo SMC utilizado por esta funcionalidade."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac ondersteunt geen laadbeheer. Het ontbreekt aan het SMC-register dat deze functie gebruikt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Mac-datorn stöder inte laddningskontroll. Den saknar det SMC-register som den här funktionen använder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac understøtter ikke opladningsstyring. Den mangler det SMC-register, som denne funktion bruger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei tue latauksen hallintaa. Siitä puuttuu tämän toiminnon käyttämä SMC-rekisteri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen støtter ikke ladekontroll. Den mangler SMC-registeret denne funksjonen bruker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie obsługuje sterowania ładowaniem. Brakuje w nim rejestru SMC używanego przez tę funkcję."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac nepodporuje ovládání nabíjení. Chybí mu registr SMC, který tato funkce používá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Mac nem támogatja a töltésvezérlést. Hiányzik belőle az ehhez a funkcióhoz használt SMC-regiszter."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac nu acceptă controlul încărcării. Îi lipsește registrul SMC folosit de această funcție."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Mac δεν υποστηρίζει τον έλεγχο φόρτισης. Δεν διαθέτει τον καταχωρητή SMC που χρησιμοποιεί αυτή η λειτουργία."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не поддерживает управление зарядкой. В нем отсутствует регистр SMC, который использует эта функция."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac не підтримує керування заряджанням. У ньому немає регістру SMC, який використовує ця функція."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac şarj kontrolünü desteklemiyor. Bu özelliğin kullandığı SMC yazmacına sahip değil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac لا يدعم التحكم في الشحن. فهو يفتقر إلى سجل SMC الذي تستخدمه هذه الميزة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה אינו תומך בבקרת טעינה. חסר לו רגיסטר ה-SMC שבו תכונה זו משתמשת."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ไม่รองรับการควบคุมการชาร์จ เนื่องจากไม่มีรีจิสเตอร์ SMC ที่ฟีเจอร์นี้ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này không hỗ trợ kiểm soát sạc. Máy thiếu thanh ghi SMC mà tính năng này sử dụng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini tidak mendukung kontrol pengisian daya. Mac ini tidak memiliki register SMC yang digunakan fitur ini."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac चार्ज नियंत्रण का समर्थन नहीं करता है। इसमें वह SMC रजिस्टर नहीं है जिसका उपयोग यह सुविधा करती है।"
          }
        }
      }
    },
    "이 속도로는 제한 시간 안에 방전을 마칠 수 없습니다. Mac을 사용 중인 상태로 두면 방전이 빨라집니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بهذه السرعة لا يمكن إكمال التفريغ ضمن المهلة. استخدام الـ Mac سيسرّعه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto tempem se vybíjení nestihne dokončit v časovém limitu. Používání Macu ho zrychlí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med denne hastighed kan afladningen ikke nå at blive færdig inden for tidsgrænsen. Brug af din Mac gør den hurtigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Tempo kann die Entladung nicht innerhalb des Zeitlimits abgeschlossen werden. Wenn Sie den Mac benutzen, entlädt er schneller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτόν τον ρυθμό η εκφόρτιση δεν μπορεί να ολοκληρωθεί εντός του χρονικού ορίου. Η χρήση του Mac θα την επιταχύνει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this rate the discharge cannot finish within the time limit. Using your Mac will speed it up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A este ritmo, la descarga no puede terminar dentro del límite de tiempo. Usar el Mac la acelerará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä nopeudella purkaus ei ehdi valmistua aikarajassa. Macin käyttäminen nopeuttaa sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce rythme, la décharge ne peut pas se terminer dans le délai imparti. Utiliser votre Mac l'accélérera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקצב הזה הפריקה לא תסתיים בתוך מגבלת הזמן. שימוש ב-Mac יאיץ אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस गति से डिस्चार्ज समय-सीमा के भीतर पूरा नहीं हो सकता। Mac का उपयोग करने से यह तेज़ होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilyen ütemben a kisütés nem fejeződik be az időkorláton belül. A Mac használata felgyorsítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan laju ini, pengosongan tidak dapat selesai dalam batas waktu. Menggunakan Mac akan mempercepatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A questa velocità la scarica non può terminare entro il limite di tempo. Usare il Mac la velocizzerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この速度では制限時間内に放電を終えられません。Macを使用中の状態にすると放電が速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 속도로는 제한 시간 안에 방전을 마칠 수 없습니다. Mac을 사용 중인 상태로 두면 방전이 빨라집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I dette tempoet rekker ikke utladingen å bli ferdig innen tidsgrensen. Å bruke Macen gjør den raskere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met dit tempo kan het ontladen niet binnen de tijdslimiet worden voltooid. Je Mac gebruiken versnelt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym tempie rozładowanie nie zakończy się w wyznaczonym czasie. Korzystanie z Maca je przyspieszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesse ritmo, a descarga não termina dentro do limite de tempo. Usar o Mac vai acelerá-la."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A este ritmo, a descarga não termina dentro do limite de tempo. Utilizar o Mac irá acelerá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În acest ritm, descărcarea nu se poate finaliza în limita de timp. Folosirea Mac-ului o va accelera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С такой скоростью разрядка не завершится в отведённое время. Работа на Mac ускорит её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I den här takten hinner urladdningen inte bli klar inom tidsgränsen. Att använda din Mac snabbar upp den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้วยอัตรานี้ การคายประจุจะไม่เสร็จภายในเวลาที่กำหนด การใช้งาน Mac จะช่วยให้เร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hızda deşarj, süre sınırı içinde tamamlanamaz. Mac'inizi kullanmanız deşarjı hızlandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З такою швидкістю розряджання не завершиться у відведений час. Робота на Mac пришвидшить його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tốc độ này, quá trình xả không thể hoàn tất trong thời gian cho phép. Sử dụng Mac sẽ giúp xả nhanh hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以当前速度无法在时限内完成放电。继续使用 Mac 可加快放电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以目前速度無法在時限內完成放電。繼續使用 Mac 可加快放電。"
          }
        }
      }
    },
