    "완충 후 %lld시간이 지나 기존 충전 제한으로 복귀했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완충 후 %lld시간이 지나 기존 충전 제한으로 복귀했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hours after reaching full charge, your usual charge limit has been restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "満充電から%lld時間が経過したため、元の充電上限に戻しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充满后已过 %lld 小时，已恢复原有充电上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "充滿後已過 %lld 小時，已恢復原有充電上限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Stunden nach dem Vollladen wurde die übliche Ladegrenze wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld heures après la charge complète, la limite de charge habituelle a été rétablie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld horas después de la carga completa, se ha restaurado el límite de carga habitual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ore dopo la carica completa, il limite di carica abituale è stato ripristinato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld horas após a carga completa, o limite de carga habitual foi restaurado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld horas após a carga completa, o limite de carga habitual foi reposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через %lld ч после полной зарядки восстановлен обычный предел заряда."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld uur na het volladen is de gebruikelijke laadlimiet hersteld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld timmar efter fulladdning har den vanliga laddgränsen återställts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld timer efter fuld opladning er den normale opladningsgrænse gendannet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld timer etter full lading er den vanlige ladegrensen gjenopprettet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tuntia täyteen lataamisen jälkeen tavallinen latausraja palautettiin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld godz. po pełnym naładowaniu przywrócono zwykły limit ładowania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hodin po plném nabití byl obnoven obvyklý limit nabíjení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes töltés után %lld órával visszaállt a megszokott töltési korlát."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La %lld ore după încărcarea completă, limita obișnuită de încărcare a fost restabilită."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ώρες μετά την πλήρη φόρτιση, το συνηθισμένο όριο φόρτισης αποκαταστάθηκε."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam doluluktan %lld saat sonra normal şarj sınırına dönüldü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через %lld год після повного заряду відновлено звичайний ліміт заряду."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld שעות לאחר טעינה מלאה, מגבלת הטעינה הרגילה שוחזרה."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد %lld ساعة من اكتمال الشحن، تمت استعادة حد الشحن المعتاد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा चार्ज होने के %lld घंटे बाद सामान्य चार्ज सीमा बहाल कर दी गई।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากชาร์จเต็มแล้ว %lld ชั่วโมง ระบบได้กลับไปใช้ขีดจำกัดการชาร์จเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau %lld giờ kể từ khi sạc đầy, giới hạn sạc thường ngày đã được khôi phục."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jam setelah terisi penuh, batas pengisian biasa telah dipulihkan."
          }
        }
      }
    },
