    "• %@: 기본 최소 RPM 이상으로 복귀": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: العودة إلى الحد الأدنى الافتراضي لعدد الدورات في الدقيقة أو أعلى"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: Návrat na výchozí minimální RPM nebo vyšší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: Vend tilbage til standard minimum-RPM eller derover"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• %@: Rückkehr zur Standard-Mindestdrehzahl oder höher"
