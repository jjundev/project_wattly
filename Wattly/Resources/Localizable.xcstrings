    "배터리 온도가 설정값을 초과하면 충전을 일시 중단하여 배터리 수명을 보호합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الشحن مؤقتًا عندما تتجاوز درجة حرارة البطارية الحد المحدد لحماية عمر البطارية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaví nabíjení, když teplota baterie překročí nastavený limit, aby chránila životnost baterie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter opladning på pause, når batteritemperaturen overstiger den indstillede grænse for at beskytte batteriets levetid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert den Ladevorgang, wenn die Batterietemperatur den eingestellten Schwellenwert überschreitet, um die Akkulebensdauer zu schützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακόπτει προσωρινά τη φόρτιση όταν η θερμοκρασία της μπαταρίας υπερβαίνει το καθορισμένο όριο για την προστασία της διάρκειας ζωής της μπαταρίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses charging when the battery temperature exceeds the set threshold to protect battery health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga cuando la temperatura de la batería supera el umbral establecido para proteger la vida útil de la batería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeyttää latauksen, kun akun lämpötila ylittää asetetun kynnyksen, akun käyttöiän suojaamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend la charge lorsque la température de la batterie dépasse le seuil défini pour préserver la durée de vie de la batterie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהה את הטעינה כאשר טמפרטורת הסוללה חורגת מהסף שהוגדר כדי להגן על חיי הסוללה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी लाइफ की सुरक्षा के लिए बैटरी का तापमान निर्धारित सीमा से अधिक होने पर चार्जिंग को रोक देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szünetelteti a töltést, ha az akkumulátor hőmérséklete meghaladja a beállított küszöbértéket az akkumulátor élettartamának védelme érdekében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda pengisian daya saat suhu baterai melebihi ambang batas yang ditentukan untuk melindungi kesehatan baterai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospende la ricarica quando la temperatura della batteria supera la soglia impostata per proteggere la durata della batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー温度が設定値を超えると充電を一時停止し、バッテリー寿命を保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 설정값을 초과하면 충전을 일시 중단하여 배터리 수명을 보호합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter ladingen på pause når batteritemperaturen overskrider den angitte grensen for å beskytte batteriets levetid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeert het opladen wanneer de batterijtemperatuur de ingestelde drempelwaarde overschrijdt om de levensduur van de batterij te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje ładowanie, gdy temperatura baterii przekroczy ustawiony próg, aby chronić jej żywotność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o carregamento quando a temperatura da bateria excede o limite definido para proteger a vida útil da bateria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o carregamento quando a temperatura da bateria excede o limite definido para proteger a vida útil da bateria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întrerupe încărcarea când temperatura bateriei depășește pragul setat pentru a proteja durata de viață a bateriei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает зарядку при превышении заданной температуры для защиты аккумулятора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar laddningen när batteritemperaturen överstiger det inställda gränsvärdet för att skydda batteriets livslängd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชาร์จชั่วคราวเมื่ออุณหภูมิแบตเตอรี่เกินค่าที่ตั้งไว้เพื่อปกป้องอายุการใช้งานของแบตเตอรี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil sıcaklığı belirlenen eşiği aştığında pil ömrünü korumak için şarjı duraklatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиняє заряджання, якщо температура акумулятора перевищує встановлений поріг, для захисту терміну служби акумулятора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng sạc khi nhiệt độ pin vượt quá ngưỡng đã đặt để bảo vệ tuổi thọ của pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当电池温度超过设定阈值时暂停充电，以保护电池寿命。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當電池溫度超過設定閾值時暫停充電，以保護電池壽命。"
          }
        }
      }
    },
