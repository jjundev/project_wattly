    "12시간 동안 진행이 없어 자동으로 취소하고 원래 충전 설정으로 되돌렸습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing progressed for 12 hours, so it was cancelled and your charging settings were restored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 12 Stunden lang kein Fortschritt erzielt wurde, wurde der Vorgang abgebrochen und deine Ladeeinstellungen wurden wiederhergestellt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12時間進行がなかったため自動的にキャンセルされ、元の充電設定に戻されました。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune progression n'a eu lieu pendant 12 heures, l'opération a donc été annulée et vos réglages de charge ont été restaurés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hubo progreso durante 12 horas, por lo que se canceló y se restauraron tus ajustes de carga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono stati progressi per 12 ore, quindi è stato annullato e le tue impostazioni di ricarica sono state ripristinate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve progresso por 12 horas, então foi cancelado e suas configurações de carregamento foram restauradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não houve progresso durante 12 horas, pelo que foi cancelado e as suas definições de carregamento foram restauradas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er was 12 uur lang geen voortgang, dus is het geannuleerd en zijn je oplaadinstellingen hersteld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen framgång skedde på 12 timmar, så det avbröts och dina laddningsinställningar återställdes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der var ingen fremgang i 12 timer, så det blev annulleret, og dine opladningsindstillinger blev gendannet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etenemistä ei tapahtunut 12 tuntiin, joten se peruutettiin ja latausasetuksesi palautettiin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ingen fremgang på 12 timer, så det ble avbrutt og ladeinnstillingene dine ble gjenopprettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez 12 godzin nie nastąpił żaden postęp, więc anulowano procedurę i przywrócono Twoje ustawienia ładowania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dobu 12 hodin nedošlo k žádnému postupu, proto byl proces zrušen a vaše nastavení nabíjení bylo obnoveno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "12 órán át nem történt előrehaladás, ezért megszakadt, és a töltési beállításaid visszaálltak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a existat niciun progres timp de 12 ore, așa că a fost anulat, iar setările tale de încărcare au fost restaurate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν σημειώθηκε πρόοδος για 12 ώρες, οπότε ακυρώθηκε και οι ρυθμίσεις φόρτισής σας επαναφέρθηκαν."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В течение 12 часов не было прогресса, поэтому процедура была отменена, а ваши настройки зарядки восстановлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Протягом 12 годин не було прогресу, тому процедуру скасовано, а ваші налаштування заряджання відновлено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12 saat boyunca ilerleme kaydedilmediği için işlem iptal edildi ve şarj ayarlarınız geri yüklendi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحرز أي تقدم لمدة 12 ساعة، لذا تم إلغاء العملية واستعادة إعدادات الشحن الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הייתה התקדמות במשך 12 שעות, ולכן התהליך בוטל והגדרות הטעינה שלך שוחזרו."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีความคืบหน้าเป็นเวลา 12 ชั่วโมง จึงถูกยกเลิกโดยอัตโนมัติและคืนค่าการตั้งค่าการชาร์จของคุณแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tiến triển nào trong 12 giờ, vì vậy quá trình đã bị hủy và cài đặt sạc của bạn đã được khôi phục."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kemajuan selama 12 jam, sehingga proses dibatalkan dan pengaturan pengisian daya Anda dipulihkan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "12 घंटे तक कोई प्रगति नहीं हुई, इसलिए इसे रद्द कर दिया गया और आपकी चार्जिंग सेटिंग्स पुनर्स्थापित कर दी गईं।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "12 小时内没有进展，因此已自动取消并恢复了你的充电设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "12 小時內沒有進展，因此已自動取消並還原了你的充電設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12시간 동안 진행이 없어 자동으로 취소하고 원래 충전 설정으로 되돌렸습니다."
          }
        }
      }
    },
