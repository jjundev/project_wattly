    "원하는 목표 잔량까지 배터리를 전원 어댑터 연결 상태에서 강제로 방전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcefully discharge the battery to your target while connected to power adapter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 목표 잔량까지 배터리를 전원 어댑터 연결 상태에서 강제로 방전합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفرض تفريغ البطارية إلى المستوى المستهدف المطلوب أثناء الاتصال بمحول الطاقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynutí vybití baterie na požadovanou úroveň při připojení k napájecímu adaptéru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemtvinger batteriafladning til det ønskede målniveau, mens der er tilsluttet strømforsyning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwingt das Entladen des Akkus auf den gewünschten Zielwert, während das Netzteil angeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαναγκάζει την εκφόρτιση της μπαταρίας στο επιθυμητό επίπεδο-στόχο ενώ είναι συνδεδεμένο το τροφοδοτικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuerza la descarga de la batería hasta el nivel objetivo deseado mientras está conectada a la corriente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakottaa akun purkamisen halutulle tavoitetasolle virtalähteen ollessa kytkettynä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force la décharge de la batterie jusqu'au niveau cible souhaité pendant la connexion à l'adaptateur secteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פורק את הסוללה בכוח לרמת היעד הרצויה בזמן חיבור למתאם החשמל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पावर एडाप्टर से कनेक्ट होने के दौरान बैटरी को वांछित लक्ष्य स्तर तक जबरन डिस्चार्ज करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kényszeríti az akkumulátor lemerítését a kívánt célszintre hálózati adapterhez csatlakoztatott állapotban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memaksa pengosongan daya baterai ke tingkat target yang diinginkan saat terhubung ke adaptor daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forza la scarica della batteria fino al livello target desiderato mentre è collegata all'alimentatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタに接続した状態で、バッテリーを希望の目標残量まで強制的に放電します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvinger utlading av batteriet til ønsket målnivå mens strømadapteren er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaadt de batterij geforceerd tot het gewenste doelniveau terwijl deze is aangesloten op de lichtnetadapter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymusza rozładowanie baterii do żądanego poziomu docelowego przy podłączonym zasilaczu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força a descarga da bateria até o nível alvo desejado enquanto conectada ao adaptador de alimentação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Força a descarga da bateria até ao nível pretendido enquanto ligada ao adaptador de corrente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Forțează descărcarea bateriei până la nivelul țintă dorit în timp ce este conectată la adaptorul de alimentare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительно разряжает аккумулятор до целевого уровня при подключенном адаптере питания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvingar urladdning av batteriet till önskad målnivå medan strömadaptern är ansluten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บังคับให้คายประจุแบตเตอรี่ถึงระดับเป้าหมายที่ต้องการในขณะที่เชื่อมต่อกับอะแดปเตอร์แปลงไฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç adaptörüne bağlıyken pili istenen hedef seviyeye kadar zorla deşarj eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Примусово розряджає акумулятор до бажаного цільового рівня при під'єднаному адаптері живлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buộc xả pin đến mức mục tiêu mong muốn trong khi vẫn kết nối với bộ tiếp hợp nguồn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连接电源适配器的状态下强制放电至所需的目标电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在連接電源轉接器的狀態下強制放電至所需之目標電量。"
          }
        }
      }
    },
    "원활한 동작을 위해 시스템 설정 > 배터리의 '최적화된 배터리 충전'을 꺼두는 것을 권장합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원활한 동작을 위해 시스템 설정 > 배터리의 '최적화된 배터리 충전'을 꺼두는 것을 권장합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For reliable operation, we recommend turning off “Optimized Battery Charging” in System Settings › Battery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確実に動作させるため、システム設定 > バッテリーの「バッテリー充電の最適化」をオフにすることをおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为确保稳定运行，建议在系统设置 > 电池中关闭“优化电池充电”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為確保穩定運作，建議在系統設定 > 電池中關閉「最佳化電池充電」。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen zuverlässigen Betrieb empfehlen wir, „Optimiertes Laden der Batterie“ in den Systemeinstellungen › Batterie zu deaktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un fonctionnement fiable, nous vous recommandons de désactiver « Charge de batterie optimisée » dans Réglages Système › Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un funcionamiento fiable, te recomendamos desactivar “Carga optimizada de la batería” en Ajustes del Sistema › Batería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un funzionamento affidabile, ti consigliamo di disattivare “Ricarica ottimizzata della batteria” in Impostazioni di Sistema › Batteria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma operação confiável, recomendamos desativar a “Carga Otimizada da Bateria” em Ajustes do Sistema › Bateria."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um funcionamento fiável, recomendamos desativar a “Carga Otimizada da Bateria” em Definições do Sistema › Bateria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een betrouwbare werking raden we aan om ‘Geoptimaliseerd batterijladen’ in Systeeminstellingen › Batterij uit te schakelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För tillförlitlig funktion rekommenderar vi att du inaktiverar ”Optimerad batteriladdning” i Systeminställningar › Batteri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For pålidelig drift anbefaler vi, at du slår “Optimeret batteriopladning” fra i Systemindstillinger › Batteri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luotettavan toiminnan varmistamiseksi suosittelemme poistamaan käytöstä ”Optimoitu akun lataus” kohdassa Järjestelmäasetukset › Akku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For pålitelig drift anbefaler vi å slå av «Optimalisert batterilading» i Systeminnstillinger › Batteri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapewnić niezawodne działanie, zalecamy wyłączenie opcji „Zoptymalizowane ładowanie baterii” w Ustawieniach systemowych › Bateria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro spolehlivý provoz doporučujeme vypnout „Optimalizované nabíjení baterie“ v Nastavení systému › Baterie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megbízható működés érdekében javasoljuk az „Optimalizált akkumulátortöltés” kikapcsolását a Rendszerbeállítások › Akkumulátor menüben."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru o funcționare fiabilă, îți recomandăm să dezactivezi „Încărcare optimizată a bateriei” din Setări sistem › Baterie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για αξιόπιστη λειτουργία, σας συνιστούμε να απενεργοποιήσετε τη «Βελτιστοποιημένη φόρτιση μπαταρίας» στις Ρυθμίσεις Συστήματος › Μπαταρία."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для надежной работы рекомендуем отключить «Оптимизированную зарядку батареи» в Системных настройках › Батарея."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для надійної роботи рекомендуємо вимкнути «Оптимізоване заряджання акумулятора» в Системних налаштуваннях › Акумулятор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenilir çalışma için Sistem Ayarları › Pil bölümünde “Optimize Edilmiş Pil Şarjı”nı kapatmanızı öneririz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لضمان تشغيل موثوق، نوصي بإيقاف تشغيل ”شحن البطارية المُحسَّن“ في إعدادات النظام › البطارية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפעולה אמינה, מומלץ לכבות את ”טעינת סוללה מותאמת“ בהגדרות המערכת › סוללה."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อการทำงานที่เชื่อถือได้ เราขอแนะนำให้ปิด “การชาร์จแบตเตอรี่แบบเพิ่มประสิทธิภาพ” ในการตั้งค่าระบบ › แบตเตอรี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để hoạt động ổn định, chúng tôi khuyên bạn nên tắt “Sạc pin được tối ưu hóa” trong Cài đặt Hệ thống › Pin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pengoperasian yang andal, sebaiknya nonaktifkan “Pengisian Daya Baterai yang Dioptimalkan” di Pengaturan Sistem › Baterai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्वसनीय संचालन के लिए, हम सिस्टम सेटिंग्स › बैटरी में “ऑप्टिमाइज़्ड बैटरी चार्जिंग” को बंद करने की सलाह देते हैं।"
          }
        }
      }
    },
