    "배터리 온도 센서를 읽을 수 없습니다": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر قراءة مستشعر درجة حرارة البطارية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze načíst snímač teploty baterie"
          }
        },
        "da": {
