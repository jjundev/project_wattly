        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّث المقاييس النشطة كل ثانيتين بغض النظر عن حالة اللوحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעדכן מדדים פעילים כל 2 שניות ללא קשר למצב החלונית."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตตัวชี้วัดที่ใช้งานอยู่ทุก 2 วินาที โดยไม่คำนึงถึงสถานะของแผงควบคุม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật các chỉ số đang hoạt động mỗi 2 giây bất kể trạng thái của bảng điều khiển."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui metrik aktif setiap 2 detik terlepas dari status panel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैनल की स्थिति की परवाह किए बिना हर 2 सेकंड में सक्रिय मेट्रिक्स को अपडेट करता है।"
          }
        }
      }
    },
    "패널 상태와 관계없이 활성 지표를 5초마다 갱신합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 상태와 관계없이 활성 지표를 5초마다 갱신합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates active metrics every 5 seconds regardless of panel state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの状態に関係なく、アクティブな指標を5秒ごとに更新します。"
