    "충전 한도를 현재 잔량보다 낮게 변경하면 별도 조작 없이 자동으로 한도까지 방전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically discharge to the limit when a lower charge limit is set."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 한도를 현재 잔량보다 낮게 변경하면 별도 조작 없이 자동으로 한도까지 방전합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفريغ التلقائي إلى الحد عند تعيين حد شحن أقل من المستوى الحالي دون إجراءات إضافية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nastavení nižšího limitu nabíjení se baterie automaticky vybije na tento limit bez dalších zásahů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aflader automatisk til grænsen uden yderligere handling, hvis der vælges en lavere opladningsgrænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird das Ladelimit unter den aktuellen Stand gesenkt, wird der Akku automatisch und ohne weitere Schritte bis zum Limit entladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκφορτίζει αυτόματα στο όριο χωρίς πρόσθετες ενέργειες όταν οριστεί χαμηλότερο όριο φόρτισης από το τρέχον επίπεδο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga automáticamente hasta el límite sin acciones adicionales al establecer un límite de carga inferior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Purkaa akun automaattisesti rajaan asti ilman lisätoimia, kun asetetaan nykyistä alhaisempi latausraja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharge automatiquement jusqu'à la limite sans action supplémentaire lorsqu'une limite inférieure est définie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פורק אוטומטית למגבלה ללא פעולה נוספת בעת הגדרת מגבלת טעינה נמוכה מהרמה הנוכחית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान स्तर से कम चार्ज सीमा निर्धारित करने पर बिना किसी अतिरिक्त कार्रवाई के स्वचालित रूप से सीमा तक डिस्चार्ज हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan lemeríti az akkumulátort a határértékig, ha az aktuálisnál alacsonyabb töltési korlátot állít be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengosongkan daya secara otomatis ke batas tanpa tindakan tambahan saat menetapkan batas yang lebih rendah dari daya saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica automaticamente fino al limite senza ulteriori operazioni quando viene impostato un limite inferiore al livello attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電上限を現在残量より低く設定すると、追加操作なしで自動的に上限まで放電します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader automatisk ut til grensen uten ekstra handling når du setter en lavere ladebegrensning enn gjeldende nivå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaadt automatisch tot de limiet zonder extra handelingen wanneer een lagere oplaadlimiet wordt ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie rozładowuje baterię do limitu bez dodatkowych działań po ustawieniu niższego limitu ładowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega automaticamente até o limite sem ações extras ao definir um limite inferior ao nível atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega automaticamente até ao limite sem ações adicionais ao definir um limite inferior ao nível atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă automat până la limită fără acțiuni suplimentare când se setează o limită de încărcare mai mică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически разряжает аккумулятор до предела без дополнительных действий при установке более низкого лимита."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar automatiskt ur till gränsen utan extra åtgärder när en lägre laddningsgräns än nuvarande nivå ställs in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะคายประจุถึงขีดจำกัดโดยอัตโนมัติโดยไม่ต้องดำเนินการเพิ่มเติม เมื่อตั้งค่าขีดจำกัดการชาร์จต่ำกว่าระดับปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj sınırı mevcut seviyeden daha düşüğe ayarlandığında ek işlem gerekmeden otomatik olarak sınıra kadar deşarj eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично розряджає акумулятор до ліміту без додаткових дій при встановленні нижчого ліміту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động xả pin đến giới hạn mà không cần thêm thao tác khi đặt giới hạn sạc thấp hơn mức hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将充电限制更改为低于当前电量时，无需额外操作即可自动放电至该限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將充電限制變更為低於目前電量時，無需額外操作即可自動放電至該限制。"
          }
        }
      }
    },
    "충전 허용 상태를 확인하지 못해 Wattly 삭제를 중단했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من حالة الشحن المسموح بها، تم إيقاف إزالة Wattly."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze ověřit stav povolení nabíjení, odinstalace Wattly byla zrušena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekræfte opladningstilstand, afinstallation af Wattly stoppet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladeerlaubnisstatus konnte nicht überprüft werden, Wattly-Deinstallation abgebrochen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η επαλήθευση της κατάστασης φόρτισης, η απεγκατάσταση του Wattly διακόπηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify charging state, uninstallation aborted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el estado de carga permitida; desinstalación de Wattly cancelada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataustilaa ei voitu vahvistaa, Wattlyn asennuksen poisto keskeytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l'état d'autorisation de charge, suppression de Wattly interrompue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את מצב הטעינה המותרת, הסרת Wattly הופסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्जिंग अनुमति स्थिति सत्यापित नहीं की जा सकी, Wattly अनइंस्टॉलेशन रुका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a töltés engedélyezett állapotát, a Wattly eltávolítása megszakadt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memverifikasi status izin pengisian, pencopotan Wattly dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare lo stato di carica consentito, rimozione di Wattly interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電許可状態を確認できなかったため、Wattlyの削除を中止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 허용 상태를 확인하지 못해 Wattly 삭제를 중단했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke bekrefte ladestatus, fjerning av Wattly avbrutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon status voor toegestaan opladen niet verifiëren, verwijderen van Wattly gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować stanu zezwolenia na ładowanie, przerwano usuwanie Wattly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o status de permissão de carga, remoção do Wattly cancelada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o estado de permissão de carregamento, remoção do Wattly cancelada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut verifica starea de permitere a încărcării, dezinstalarea Wattly a fost oprită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить состояние разрешения зарядки, удаление Wattly отменено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte verifiera status för tillåten laddning, borttagning av Wattly avbröts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจสอบสถานะการอนุญาตให้ชาร์จได้ ยกเลิกการถอนการติดตั้ง Wattly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj izin durumu doğrulanamadı, Wattly kaldırma işlemi durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити стан дозволу заряджання, видалення Wattly зупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh trạng thái cho phép sạc, đã dừng gỡ cài đặt Wattly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能验证允许充电状态，Wattly 卸载已中止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能驗證允許充電狀態，Wattly 解除安裝已中止。"
          }
        }
      }
    },
    "충전을 다시 시작하지 못했습니다 (전원 어댑터를 다시 연결해 보세요)": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전을 다시 시작하지 못했습니다 (전원 어댑터를 다시 연결해 보세요)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume charging (try reconnecting the power adapter)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電を再開できませんでした（電源アダプタを接続し直してください）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
