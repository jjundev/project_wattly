    "맥북 쿨링 팬 블레이드가 부하에 맞춰 고속 회전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدور شفرات مروحة تبريد MacBook بسرعة عالية وفقًا للحمل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopatky chladicího ventilátoru MacBooku se otáčejí vysokou rychlostí podle zatížení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBookens blæserblade roterer med høj hastighed i takt med belastningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lüfterflügel des MacBook drehen sich je nach Last mit hoher Geschwindigkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λεπίδες του ανεμιστήρα ψύξης του MacBook περιστρέφονται με υψηλή ταχύτητα ανάλογα με το φορτίο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook cooling fan blades rotate at high speed according to load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aspas del ventilador del MacBook giran a alta velocidad según la carga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBookin tuulettimen lavat pyörivät suurella nopeudella kuormituksen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pales du ventilateur du MacBook tournent à grande vitesse en fonction de la charge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להבי מאוורר הקירור של MacBook מסתובבים במהירות גבוהה בהתאם לעומס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैकबुक कूलिंग फैन ब्लेड लोड के अनुसार तेज गति से घूमते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A MacBook hűtőventilátor lapátjai nagy sebességgel forognak a terheléstől függően."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah kipas pendingin MacBook berputar dengan kecepatan tinggi sesuai beban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pale della ventola di raffreddamento del MacBook ruotano ad alta velocità in base al carico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBookの冷却ファンブレードが負荷に合わせて高速回転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맥북 쿨링 팬 블레이드가 부하에 맞춰 고속 회전합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook-viftebladene roterer i høy hastighet i henhold til belastning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ventilatorbladen van de MacBook draaien met hoge snelheid afhankelijk van de belasting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łopatki wentylatora MacBooka obracają się z dużą prędkością w zależności od obciążenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pás da ventoinha de resfriamento do MacBook giram em alta velocidade de acordo com a carga."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As pás da ventoinha de arrefecimento do MacBook rodam a alta velocidade de acordo com a carga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Palele ventilatorului MacBook se rotesc la viteză mare în funcție de sarcină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лопасти вентилятора MacBook вращаются с высокой скоростью в зависимости от нагрузки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBooks fläktblad roterar i hög hastighet beroende på belastning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบพัดระบายความร้อนของ MacBook หมุนด้วยความเร็วสูงตามโหลดการทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook soğutma fanı kanatları yüke göre yüksek hızda döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лопаті вентилятора MacBook обертаються з високою швидкістю відповідно до навантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cánh quạt làm mát MacBook quay ở tốc độ cao theo tải hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook 散热风扇叶片根据负载高速旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MacBook 散熱風扇葉片根據負載高速旋轉。"
          }
        }
      }
    },
    "메뉴바": {
