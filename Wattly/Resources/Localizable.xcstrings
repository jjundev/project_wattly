    "유지보수: 다른 사용자가 이 Mac의 충전 정책을 관리하고 있습니다": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدير مستخدم آخر سياسة الشحن لهذا الـ Mac"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady nabíjení pro tento Mac spravuje jiný uživatel"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden bruger administrerer opkrævningspolitikken for denne Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Benutzer verwaltet die Ladungsrichtlinie für diesen Mac"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άλλος χρήστης διαχειρίζεται την πολιτική χρέωσης για αυτό το Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another user manages this Mac's charge policy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro usuario está gestionando la política de carga de este Mac"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen käyttäjä hallinnoi tämän Macin latauskäytäntöä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre utilisateur gère la politique de charge pour ce Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש אחר מנהל את מדיניות הטעינה עבור Mac זה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अन्य यूज़र इस Mac के लिए चार्जिंग नीति मैनेज कर रहा है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik felhasználó kezeli a Mac töltési szabályzatát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna lain mengelola kebijakan pengisian daya untuk Mac ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro utente sta gestendo la politica di ricarica per questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のユーザーがこのMacの請求ポリシーを管理しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자가 이 Mac의 충전 정책을 관리하고 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen bruker administrerer ladepolicyen for denne Mac-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere gebruiker beheert het oplaadbeleid voor deze Mac"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny użytkownik zarządza zasadami ładowania dla tego komputera Mac"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro usuário está gerenciando a política de cobrança para este Mac"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro utilizador está a gerir a política de carregamento para este Mac"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt utilizator gestionează politica de încărcare pentru acest Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой пользователь управляет политикой зарядки для этого Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan användare hanterar laddningspolicyn för denna Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้อีกคนกำลังจัดการนโยบายการชาร์จสำหรับ Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kullanıcı bu Mac için ücretlendirme politikasını yönetiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший користувач керує політикою заряджання для цього Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người dùng khác đang quản lý chính sách sạc cho máy Mac này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个用户正在管理此Mac的充电策略"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一位用戶正在管理此Mac的收費政策"
          }
        }
      }
    },
    "유지보수: 다른 사용자의 충전 정책을 해제하고 이 사용자로 소유권을 이전합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار سياسة شحن مستخدم آخر ونقل الملكية إلى هذا المستخدم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolněte zásady účtování jiného uživatele a převeďte vlastnictví na tohoto uživatele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frigør en anden brugers opkrævningspolitik, og overfør ejerskabet til denne bruger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Gebührenrichtlinie eines anderen Benutzers frei und übertragen Sie das Eigentum an diesen Benutzer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκδώστε την πολιτική χρέωσης άλλου χρήστη και μεταβιβάστε την κυριότητα σε αυτόν τον χρήστη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the other user's charge policy and transfer ownership to this user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere la política de cobro de otro usuario y transfiera la propiedad a este usuario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapauta toisen käyttäjän veloituskäytäntö ja siirrä omistajuus tälle käyttäjälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez la politique de facturation d'un autre utilisateur et transférez la propriété à cet utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשחרר את מדיניות הטעינה של משתמש אחר ולהעביר את הבעלות למשתמש זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे यूज़र की चार्जिंग नीति जारी करें और इस यूज़र को अपना मालिकाना हक ट्रांसफ़र करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedje el egy másik felhasználó díjszabályzatát, és adja át a tulajdonjogot ennek a felhasználónak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan kebijakan penagihan pengguna lain dan transfer kepemilikan kepada pengguna ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia la politica di addebito di un altro utente e trasferisci la proprietà a questo utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のユーザーの請求ポリシーを解除し、所有権をこのユーザーに譲渡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자의 충전 정책을 해제하고 이 사용자로 소유권을 이전합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp den andre brukerens betalingspolicy og overfør eierskapet til denne brukeren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef het oplaadbeleid van een andere gebruiker vrij en draag het eigendom over aan deze gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwolnij politykę opłat innego użytkownika i przenieś własność na tego użytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar a política de cobrança de outro usuário e transferir a propriedade para este usuário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberte a política de cobrança de outro utilizador e transfira a propriedade para este utilizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberați politica de încărcare a unui alt utilizator și transferați proprietatea acestui utilizator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите политику взимания платы другого пользователя и передайте право собственности этому пользователю."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp en annan användares debiteringspolicy och överför äganderätten till den här användaren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยนโยบายการเรียกเก็บเงินของผู้ใช้รายอื่นและโอนความเป็นเจ้าของให้กับผู้ใช้รายนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kullanıcının ücretlendirme politikasını yayınlayın ve mülkiyeti bu kullanıcıya devredin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звільніть політику заряджання іншого користувача та передайте право власності цьому користувачеві."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hành chính sách tính phí của người dùng khác và chuyển quyền sở hữu cho người dùng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放其他用户的收费策略，并将所有权转让给此用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放其他用戶的收費政策，並將所有權轉讓給此用戶。"
          }
        }
      }
    },
