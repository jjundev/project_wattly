    "잔잔한 바다를 순항하다가 시스템 부하가 높아지면 거센 파도와 함께 종이배가 역동적으로 출렁입니다.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الإبحار في بحر هادئ، إذا زاد حمل النظام، يتمايل القارب الورقي ديناميكيًا مع الأمواج العاتية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při plavbě po klidném moři se papírová lodička při zvýšení zatížení systému dynamicky pohupuje na divokých vlnách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under sejlads på et roligt hav vugger papirbåden dynamisk i oprørte bølger, når systembelastningen stiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ruhiger See kreuzend gerät das Papierboot bei steigender Systemlast in stürmische Wellen und schaukelt dynamisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξιδεύοντας σε ήρεμη θάλασσα, εάν το φορτίο του συστήματος αυξηθεί, το χάρτινο καραβάκι κλυδωνίζεται δυναμικά σε άγρια κύματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruising on calm seas, the paper boat rocks dynamically with stormy waves as system load increases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegando por un mar en calma, el barco de papel se balancea dinámicamente con olas tempestuosas cuando aumenta la carga del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauhallisella merellä risteilevä paperivene keinuu dynaamisesti myrskyisissä aalloissa, kun järjestelmän kuormitus kasvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naviguant sur une mer calme, le bateau en papier tangue dynamiquement sur des vagues agitées lorsque la charge du système augmente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשייט בים רגוע, אם עומס המערכת גובר, סירת הנייר מתנדנדת בדינמיות עם גלים סוערים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत समुद्र में नौकायन करते हुए, सिस्टम लोड बढ़ने पर कागज़ की नाव तूफ़ानी लहरों के साथ गतिशील रूप से हिलती है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Békés tengeren hajózva a papírhajó dinamikusan hánykolódik a viharos hullámokon, ahogy a rendszer terhelése nő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat berlayar di laut tenang, perahu kertas bergoyang dinamis mengikuti ombak badai seiring meningkatnya beban sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigando in un mare calmo, la barchetta di carta ondeggia dinamicamente tra onde tempestose all'aumentare del carico di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかな海を航行し、システム負荷が高くなると荒波とともに紙の船がダイナミックに揺れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔잔한 바다를 순항하다가 시스템 부하가 높아지면 거센 파도와 함께 종이배가 역동적으로 출렁입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under seiling på rolig hav gynger papirbåten dynamisk i stormfulle bølger når systembelastningen øker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Varend op een kalme zee schommelt de papieren boot dynamisch op onstuimige golven naarmate de systeembelasting toeneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płynąc po spokojnym morzu, papierowa łódka dynamicznie kołysze się na wzburzonych falach, gdy wzrasta obciążenie systemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegando em um mar calmo, o barquinho de papel balança dinamicamente em ondas tempestuosas conforme a carga do sistema aumenta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A navegar num mar calmo, o barco de papel balança dinamicamente em ondas tempestuosas à medida que a carga do sistema aumenta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigând pe o mare calmă, barca de hârtie se leagănă dinamic pe valuri furtunoase pe măsură ce sarcina sistemului crește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плывя по спокойному морю, бумажный кораблик динамично качается на бурных волнах по мере роста нагрузки на систему."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När systembelastningen ökar gungar pappersbåten dynamiskt på stormiga vågor efter att ha glidit fram på lugnt hav."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แล่นอยู่ในทะเลอันเงียบสงบ เมื่อโหลดของระบบสูงขึ้น เรือกระดาษจะโคลงเคลงอย่างมีพลังไปพร้อมกับคลื่นลมแรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin denizde seyrederken, sistem yükü arttığında kâğıt gemi fırtınalı dalgalarla dinamik olarak sallanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пливучи спокійним морем, паперовий кораблик динамічно гойдається на бурхливих хвилях зі зростанням навантаження на систему."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lướt trên biển êm đềm, chiếc thuyền giấy lắc lư sống động cùng những con sóng dữ khi tải hệ thống tăng lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在平静的海面上航行，当系统负载升高时，纸船会随着汹涌的波浪动态摇曳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在平靜的海面上航行，當系統負載升高時，紙船會隨著洶湧的波浪動態搖曳。"
          }
        }
      }
    },
