          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用雙欄網格緊湊排列指標，便於一目了然快速檢視。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet Messwerte in einem kompakten zweispaltigen Raster an für eine schnelle Übersicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organise les mesures dans une grille compacte à 2 colonnes pour un aperçu rapide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza las métricas en una cuadrícula compacta de 2 columnas para una vista rápida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispone le metriche in una griglia compatta a 2 colonne per una rapida panoramica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as métricas em uma grade compacta de 2 colunas para uma visão rápida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza as métricas numa grelha compacta de 2 colunas para uma visão rápida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatst statistieken in een compact raster van 2 kolommen voor een snel overzicht."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placerar mätvärden i ett kompakt 2-kolumners rutnät för en snabb överblick."
          }
        },
        "da": {
