          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latausta ei voitu jatkaa (yritä kytkeä virtalähde uudelleen)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gjenoppta ladingen (prøv å koble til strømadapteren på nytt)"
