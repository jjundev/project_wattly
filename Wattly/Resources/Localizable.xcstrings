    },
    "앱 종료·Sleep 유지를 사용하려면 도우미 업데이트가 필요합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 종료·Sleep 유지를 사용하려면 도우미 업데이트가 필요합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the helper to keep charge control active after app exit and during sleep."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث المساعد للحفاظ على التحكم بالشحن نشطًا بعد الخروج من التطبيق وأثناء وضع الإسبات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizujte pomocníka, aby řízení nabíjení zůstalo aktivní i po ukončení aplikace a během spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater hjælpeprogrammet for at bevare opladningskontrol efter appafslutning og under vågeblus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie das Hilfsprogramm, um die Ladekontrolle nach dem Beenden der App und im Ruhezustand aktiv zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώστε τον βοηθό για να διατηρήσετε ενεργό τον έλεγχο φόρτισης μετά τον τερματισμό της εφαρμογής και κατά την αναστολή λειτουργίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el asistente para mantener activo el control de carga tras salir de la app y durante el reposo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä apuohjelma pitääksesi latauksen hallinnan aktiivisena sovelluksen sulkemisen jälkeen ja nukkumisen aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour l'assistant pour maintenir le contrôle de charge actif après la fermeture de l'application et pendant la mise en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכן את המסייע כדי לשמור על בקרת הטעינה פעילה לאחר סגירת האפליקציה ובמהלך שינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप से बाहर निकलने के बाद और स्लीप के दौरान चार्ज नियंत्रण सक्रिय रखने के लिए सहायक को अपडेट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítse a segédet, hogy a töltésvezérlés aktív maradjon az alkalmazás bezárása után és alvó állapotban is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui pembantu untuk menjaga kontrol pengisian daya tetap aktif setelah keluar dari aplikasi dan saat tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna l'assistente per mantenere attivo il controllo di carica dopo la chiusura dell'app e durante lo stato di stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ終了後やスリープ中も充電制御を維持するには、ヘルパーのアップデートが必要です。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater hjelpeprogrammet for å beholde ladekontroll etter at appen lukkes og under dvale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk de helper bij om de oplaadregeling actief te houden na het afsluiten van de app en tijdens de sluimerstand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaktualizuj narzędzie pomocnicze, aby zachować kontrolę nad ładowaniem po wyjściu z aplikacji i podczas uśpienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o assistente para manter o controle de carga ativo após fechar o app e durante o repouso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o assistente para manter o controlo de carregamento ativo após fechar a aplicação e durante a suspensão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizați asistentul pentru a menține controlul încărcării activ după ieșirea din aplicație și în timpul stării de adormire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите помощника, чтобы контроль зарядки оставался активным после выхода из приложения и во время сна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdatera hjälpprogrammet för att behålla laddningskontrollen efter att appen avslutats och under viloläge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตตัวช่วยเพื่อให้การควบคุมการชาร์จยังคงทำงานหลังจากปิดแอปและระหว่างที่เครื่องหลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan çıktıktan sonra ve uyku modunda şarj kontrolünü etkin tutmak için yardımcıyı güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіть помічника, щоб контроль заряджання залишався активним після виходу з програми та під час сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật trình hỗ trợ để duy trì kiểm soát sạc sau khi thoát ứng dụng và trong khi ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新帮助程序以在退出应用程序和睡眠期间保持充电控制有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新輔助程式以在結束應用程式和睡眠期間保持充電控制有效。"
          }
        }
      }
    },
