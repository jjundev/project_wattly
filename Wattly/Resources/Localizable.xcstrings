    "배터리 온도가 %lld°C를 초과하면 충전을 일시 중단하고, %lld°C 이하로 냉각되면 재개합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 온도가 %lld°C를 초과하면 충전을 일시 중단하고, %lld°C 이하로 냉각되면 재개합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses charging when the battery exceeds %lld°C and resumes once it cools to %lld°C or below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー温度が%lld°Cを超えると充電を一時停止し、%lld°C以下に冷えると再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池温度超过 %lld°C 时暂停充电，冷却到 %lld°C 及以下时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池溫度超過 %lld°C 時暫停充電，冷卻到 %lld°C 及以下時恢復。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert das Laden bei über %lld °C und setzt es fort, sobald die Batterie auf %lld °C oder darunter abgekühlt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend la charge au-delà de %lld °C et la reprend une fois redescendue à %lld °C ou moins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga cuando la batería supera los %lld°C y la reanuda al bajar a %lld°C o menos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospende la ricarica oltre %lld°C e la riprende quando scende a %lld°C o meno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa o carregamento acima de %lld°C e retoma ao esfriar para %lld°C ou menos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspende o carregamento acima de %lld°C e retoma ao arrefecer para %lld°C ou menos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает зарядку при температуре выше %lld°C и возобновляет при охлаждении до %lld°C и ниже."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeert het opladen boven %lld°C en hervat zodra de batterij is afgekoeld tot %lld°C of lager."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuje ładowanie powyżej %lld°C i wznawia po ochłodzeniu do %lld°C lub mniej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil %lld°C üzerine çıkınca şarjı duraklatır, %lld°C ve altına düşünce sürdürür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar laddningen över %lld°C och återupptar när batteriet svalnat till %lld°C eller lägre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sætter opladning på pause over %lld°C og genoptager, når batteriet er kølet til %lld°C eller derunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Setter ladingen på pause over %lld°C og gjenopptar når batteriet er kjølt til %lld°C eller lavere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeyttää latauksen yli %lld°C:ssa ja jatkaa, kun akku on jäähtynyt %lld°C:seen tai alle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaví nabíjení nad %lld°C a obnoví je po vychladnutí na %lld°C nebo méně."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld°C fölött szünetelteti a töltést, és %lld°C-ra vagy az alá hűlve folytatja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendă încărcarea peste %lld°C și o reia când coboară la %lld°C sau mai puțin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακόπτει τη φόρτιση πάνω από %lld°C και τη συνεχίζει όταν πέσει στους %lld°C ή χαμηλότερα."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиняє заряджання вище %lld°C і відновлює після охолодження до %lld°C або нижче."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชาร์จชั่วคราวเมื่อแบตเตอรี่เกิน %lld°C และชาร์จต่อเมื่อเย็นลงถึง %lld°C หรือต่ำกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng sạc khi pin vượt %lld°C và tiếp tục khi nguội xuống %lld°C hoặc thấp hơn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjeda pengisian saat baterai melebihi %lld°C dan melanjutkan setelah turun ke %lld°C atau kurang."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैटरी %lld°C से ऊपर जाने पर चार्जिंग रोकता है और %lld°C या उससे नीचे ठंडा होने पर फिर शुरू करता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف الشحن مؤقتًا عند تجاوز %lld°C ويستأنفه عند التبريد إلى %lld°C أو أقل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהה טעינה מעל %lld°C ומחדש אותה כשהסוללה מתקררת ל-%lld°C או פחות."
          }
        }
      }
    },
    "전원 어댑터가 연결되어 있어야 방전할 수 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 어댑터가 연결되어 있어야 방전할 수 있습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect power adapter to start discharge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放電するには電源アダプタを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接电源适配器后再开始放电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連接電源轉接器後再開始放電。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe das Netzteil an, um die Entladung zu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez l’adaptateur secteur pour lancer la décharge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el adaptador de corriente para iniciar la descarga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega l’alimentatore per avviare la scarica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o adaptador de energia para iniciar a descarga."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o adaptador de corrente para iniciar a descarga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите адаптер питания, чтобы начать разрядку."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de lichtnetadapter aan om te ontladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz zasilacz, aby rozpocząć rozładowanie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deşarjı başlatmak için güç adaptörünü bağlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut nätadaptern för att starta urladdningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut strømforsyningen for at starte afladningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til strømadapteren for å starte utladingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke verkkolaite purkauksen aloittamiseksi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte napájecí adaptér a spusťte vybíjení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kisütés indításához csatlakoztasd a hálózati adaptert."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează adaptorul de alimentare pentru a începe descărcarea."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε το τροφοδοτικό για να ξεκινήσει η εκφόρτιση."
