          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att återuppta laddningen (försök att ansluta strömadaptern igen)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
