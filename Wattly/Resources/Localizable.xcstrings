    "모든 지표를 카드로 세로 배치하며 세부 펼침과 순서 변경을 지원합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지표를 카드로 세로 배치하며 세부 펼침과 순서 변경을 지원합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays all metrics vertically in expandable and reorderable cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての指標をカードとして縦に配置し、詳細の展開や順序の変更に対応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以垂直卡片形式显示所有指标，支持展开详情和重新排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以垂直卡片形式顯示所有指標，支援展開詳細資訊與重新排序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt alle Messwerte vertikal in ausklappbaren und neu anordenbaren Karten an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche toutes les mesures verticalement dans des cartes extensibles et réorganisables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todas las métricas verticalmente en tarjetas desplegables y reordenables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra tutte le metriche verticalmente in schede espandibili e riordinabili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe todas as métricas verticalmente em cartões expansíveis e reordenáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresenta todas as métricas verticalmente em cartões expansíveis e reordenáveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alle statistieken verticaal in uitklapbare en herordenbare kaarten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar alla mätvärden vertikalt i kort som kan fällas ut och ordnas om."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alle målinger lodret i kort, der kan udvides og omarrangeres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kaikki mittarit pystysuunnassa laajennettavissa ja uudelleenjärjesteltävissä korteissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser alle målinger vertikalt i kort som kan utvides og omorganiseres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla wszystkie wskaźniki pionowo na rozwijanych kartach z możliwością zmiany kolejności."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje všechny metriky svisle v rozbalitelných kartách s možností změny pořadí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes mérőszámot függőlegesen jeleníti meg kibontható és átrendezhető kártyákban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează toate valorile vertical în carduri expandabile și reordonabile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει όλες τις μετρήσεις κατακόρυφα σε επεκτεινόμενες κάρτες με δυνατότητα αναδιάταξης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает все показатели вертикально в раскрываемых карточках с возможностью изменения порядка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображає всі показники вертикально в розгортаних картках із можливістю зміни порядку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm metrikleri genişletilebilir ve yeniden sıralanabilir kartlar halinde dikey olarak görüntüler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض جميع المقاييس رأسيًا في بطاقات قابلة للتوسيع وإعادة الترتيب."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את כל המדדים אנכית בכרטיסים הניתנים להרחבה ולסידור מחדש."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงตัวชี้วัดทั้งหมดในแนวตั้งในการ์ดที่สามารถขยายและจัดลำดับใหม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tất cả chỉ số theo chiều dọc trong các thẻ có thể mở rộng và sắp xếp lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan semua metrik secara vertikal dalam kartu yang dapat diperluas dan diatur ulang urutannya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी मेट्रिक्स को लंबवत रूप से विस्तार योग्य और पुन: व्यवस्थित करने योग्य कार्डों में प्रदर्शित करता है।"
          }
        }
      }
    },
    "주요 지표 하나를 상단에 강조하고 나머지는 목록으로 표시합니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 지표 하나를 상단에 강조하고 나머지는 목록으로 표시합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights a primary metric on top and lists the rest below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主要な指標を1つ上部に強調表示し、残りをリストで表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在顶部突出显示一项主要指标，其余指标以列表形式呈现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在頂部突顯一項主要指標，其餘指標以清單形式顯示。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt einen Hauptmesswert oben hervor und listet die übrigen darunter auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en évidence une mesure principale en haut et liste les autres en dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca una métrica principal arriba y lista el resto debajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenzia una metrica principale in alto ed elenca le altre sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca uma métrica principal no topo e lista o restante abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca uma métrica principal no topo e lista as restantes abaixo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht één hoofdmeting bovenin uit en toont de rest eronder in een lijst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Framhäver ett primärt mätvärde högst upp och visar resten i en lista nedanför."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremhæver en primær måling øverst og viser resten i en liste herunder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korostaa ensisijaisen mittarin ylhäällä ja luetteloi loput sen alle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uthever en primærmåling øverst og viser resten i en liste nedenfor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyróżnia główny wskaźnik u góry, a pozostałe wyświetla poniżej w postaci listy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvýrazní hlavní metriku nahoře a zbytek zobrazí jako seznam pod ní."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiemeli a fő mérőszámot felül, a többit pedig alatta listázza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidențiază o valoare principală în partea de sus și listează restul dedesubt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τονίζει μία κύρια μέτρηση στην κορυφή και παραθέτει τις υπόλοιπες παρακάτω."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяет главный показатель вверху, а остальные отображает списком ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділяє головний показник угорі, а решту показує списком унизу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En üstte birincil metriği vurgular ve diğerlerini altta listeler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبرز المقياس الأساسي في الأعلى ويسرد الباقي في الأسفل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדגיש מדד ראשי בחלק העליון ומפרט את השאר מתחתיו."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฮไลท์ตัวชี้วัดหลักที่ด้านบนและแสดงรายการที่เหลือด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm nổi bật chỉ số chính ở trên cùng và liệt kê các chỉ số còn lại bên dưới."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyorot metrik utama di bagian atas dan mencantumkan sisanya di bawah."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्ष पर एक प्राथमिक मेट्रिक को हाइलाइट करता है और बाकी को नीचे सूचीबद्ध करता है।"
          }
        }
      }
    },
    "2열 그리드로 지표를 콤팩트하게 배치하여 한눈에 확인하기 좋습니다.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
